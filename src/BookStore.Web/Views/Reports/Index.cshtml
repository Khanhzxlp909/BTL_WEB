@model RevenueViewModel
@{
    ViewData["Title"] = ViewText.T("Báo cáo doanh thu", "Revenue Reports");
    var q = Model.Query;
    var isModelValid = ViewData.ModelState.IsValid;
    var hasFromState = ViewData.ModelState.TryGetValue(nameof(ReportQuery.FromDate), out var fromState);
    var hasToState = ViewData.ModelState.TryGetValue(nameof(ReportQuery.ToDate), out var toState);
    var fromValue = hasFromState && fromState?.AttemptedValue is not null
        ? fromState.AttemptedValue
        : q.FromDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var toValue = hasToState && toState?.AttemptedValue is not null
        ? toState.AttemptedValue
        : q.ToDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var fromError = fromState?.Errors.FirstOrDefault()?.ErrorMessage;
    var toError = toState?.Errors.FirstOrDefault()?.ErrorMessage;
    var hasFromError = !string.IsNullOrWhiteSpace(fromError);
    var hasToError = !string.IsNullOrWhiteSpace(toError);
    var maxDayRevenue = isModelValid && Model.Days.Count > 0 ? Model.Days.Max(x => x.Revenue) : 0m;
}

<div class="row g-4">
    <aside class="col-12 col-lg-3">
        @await Html.PartialAsync("_AdminNav")
    </aside>

    <div class="col-12 col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h3 bs-serif-heading mb-1">
                    @ViewText.T("Báo cáo doanh thu", "Revenue Analytics & Reports")
                </h1>
                <p class="text-secondary small mb-0">
                    @ViewText.T(
                        "Doanh thu thực nhận tính từ các đơn Đã giao hàng theo khoảng ngày lựa chọn (mặc định 30 ngày gần nhất, múi giờ UTC+7).",
                        "Realized revenue calculated from Delivered orders within the selected date range (defaults to the last 30 days, UTC+7).")
                </p>
            </div>
        </div>

        @await Html.PartialAsync("_FormErrorBanner", ViewText.T("Khoảng ngày báo cáo không hợp lệ. Vui lòng chọn lại khoảng thời gian:", "Invalid report date range. Please select a valid period:"))

        <section class="card bs-surface-card mb-4" aria-label="@ViewText.T("Bộ lọc khoảng ngày báo cáo", "Report date range filter")">
            <div class="card-body p-3 p-lg-4">
                <form method="get" action="/admin/bao-cao" novalidate>
                    <div class="row g-3 align-items-start">
                        <div class="col-12 col-sm-5 col-md-4">
                            <label for="report-from-date" class="form-label small fw-semibold mb-1">
                                @ViewText.T("Từ ngày", "From date")
                            </label>
                            <input id="report-from-date"
                                   type="date"
                                   name="FromDate"
                                   value="@fromValue"
                                   class="form-control form-control-sm @(hasFromError ? "is-invalid" : "")"
                                   aria-invalid="@(hasFromError ? "true" : null)"
                                   required />
                            @if (hasFromError)
                            {
                                <div class="invalid-feedback d-block">@fromError</div>
                            }
                        </div>

                        <div class="col-12 col-sm-5 col-md-4">
                            <label for="report-to-date" class="form-label small fw-semibold mb-1">
                                @ViewText.T("Đến ngày", "To date")
                            </label>
                            <input id="report-to-date"
                                   type="date"
                                   name="ToDate"
                                   value="@toValue"
                                   class="form-control form-control-sm @(hasToError ? "is-invalid" : "")"
                                   aria-invalid="@(hasToError ? "true" : null)"
                                   required />
                            @if (hasToError)
                            {
                                <div class="invalid-feedback d-block">@toError</div>
                            }
                        </div>

                        <div class="col-12 col-md-4">
                            <span class="form-label small d-none d-md-block mb-1 invisible" aria-hidden="true">&nbsp;</span>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-sm bs-btn-primary px-3">
                                    @ViewText.T("Xem báo cáo", "View Report")
                                </button>
                                <a href="/admin/bao-cao" class="btn btn-sm btn-outline-secondary">
                                    @ViewText.T("30 ngày mặc định", "Default 30 Days")
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        @if (isModelValid)
        {
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="bs-metric-card bs-metric-delivered p-3 rounded-3 border h-100">
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Tổng doanh thu (đơn đã giao)", "Total Revenue (Delivered)")
                    </div>
                    <div class="fs-4 fw-bold bs-price-current mb-0">@ViewText.FormatVnd(Model.TotalRevenue)</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <div class="bs-metric-card bs-metric-delivered p-3 rounded-3 border h-100">
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Số đơn đã giao", "Delivered Orders")
                    </div>
                    <div class="fs-3 fw-bold mb-0">@Model.DeliveredOrders</div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4">
                <div class="bs-metric-card bs-metric-cancelled p-3 rounded-3 border h-100">
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Số đơn bị hủy", "Cancelled Orders")
                    </div>
                    <div class="fs-3 fw-bold mb-0">@Model.CancelledOrders</div>
                </div>
            </div>
        </div>

        @* Column Chart strictly BEFORE Daily Table using the exact same Model.Days sequence *@
        <section class="card bs-surface-card mb-4" aria-labelledby="daily-revenue-heading">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 id="daily-revenue-heading" class="h5 bs-serif-heading mb-0">
                        @ViewText.T("Biểu đồ cột & Bảng doanh thu theo ngày", "Daily Revenue Column Chart & Breakdown")
                    </h2>
                    <span class="badge text-bg-light border">
                        @Model.Days.Count @ViewText.T("ngày", "days")
                    </span>
                </div>

                @if (Model.Days.Count == 0)
                {
                    <p class="text-secondary small mb-0">
                        @ViewText.T(
                            "Không có dữ liệu chuỗi ngày cho khoảng báo cáo hiện tại.",
                            "No daily series available for the current date range.")
                    </p>
                }
                else
                {
                    <div class="bs-revenue-chart-wrap mb-4" role="region" aria-label="@ViewText.T("Biểu đồ cột doanh thu theo ngày", "Daily revenue column chart")">
                        <div class="bs-revenue-chart">
                            @foreach (var day in Model.Days)
                            {
                                var pct = maxDayRevenue > 0m && day.Revenue > 0m
                                    ? Math.Clamp(Math.Round((double)(day.Revenue / maxDayRevenue) * 100d, 2), 2d, 100d)
                                    : 0d;
                                var dayLabel = day.Date.ToString("dd/MM", CultureInfo.InvariantCulture);
                                var fullDate = day.Date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture);
                                var valText = day.Revenue > 0m
                                    ? decimal.Truncate(day.Revenue).ToString("#,0", CultureInfo.GetCultureInfo("vi-VN"))
                                    : "0";
                                <div class="bs-chart-col"
                                     title="@($"{fullDate}: {ViewText.FormatVnd(day.Revenue)} ({day.DeliveredOrders})")">
                                    <span class="bs-chart-val">@valText</span>
                                    <div class="bs-chart-bar-track">
                                        @if (day.Revenue > 0m)
                                        {
                                            <div class="bs-chart-bar" style="height: @(pct.ToString("0.##", CultureInfo.InvariantCulture))%;"></div>
                                        }
                                        else
                                        {
                                            <div class="bs-chart-bar-zero"></div>
                                        }
                                    </div>
                                    <span class="bs-chart-date">@dayLabel</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="bs-admin-table-wrap">
                        <table class="table table-sm table-hover bs-admin-table mb-0">
                            <thead>
                                <tr>
                                    <th>@ViewText.T("Ngày", "Date")</th>
                                    <th class="text-center">@ViewText.T("Đơn đã giao", "Delivered Orders")</th>
                                    <th class="text-end">@ViewText.T("Doanh thu", "Revenue")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var day in Model.Days)
                                {
                                    <tr>
                                        <td class="text-nowrap">@day.Date.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)</td>
                                        <td class="text-center">@day.DeliveredOrders</td>
                                        <td class="text-end fw-semibold text-nowrap @(day.Revenue > 0m ? "bs-price-current" : "text-secondary")">
                                            @ViewText.FormatVnd(day.Revenue)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <section class="card bs-surface-card" aria-labelledby="bestsellers-heading">
            <div class="card-body p-0">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 p-lg-4 border-bottom">
                    <h2 id="bestsellers-heading" class="h5 bs-serif-heading mb-0">
                        @ViewText.T("Top 5 đầu sách bán chạy nhất", "Top 5 Best-Selling Books")
                    </h2>
                    <span class="badge text-bg-light border">
                        @Model.BestSellers.Count / 5
                    </span>
                </div>

                @if (Model.BestSellers.Count == 0)
                {
                    <div class="p-4 text-center text-secondary">
                        @ViewText.T(
                            "Chưa phát sinh sách bán ra từ các đơn Đã giao hàng trong khoảng ngày đã chọn.",
                            "No books sold from Delivered orders in the selected date range.")
                    </div>
                }
                else
                {
                    <div class="bs-admin-table-wrap">
                        <table class="table bs-admin-table mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>@ViewText.T("Tên sách", "Book Title")</th>
                                    <th>SKU</th>
                                    <th class="text-center">@ViewText.T("Số lượng đã bán", "Quantity Sold")</th>
                                    <th class="text-end">@ViewText.T("Doanh thu đóng góp", "Revenue")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.BestSellers.Count; i++)
                                {
                                    var b = Model.BestSellers[i];
                                    <tr>
                                        <td class="fw-bold text-secondary">@(i + 1)</td>
                                        <td class="fw-semibold bs-wrap-anywhere">
                                            <a href="/sach/@b.BookId" class="text-decoration-none">@b.BookTitle</a>
                                        </td>
                                        <td class="text-nowrap"><code>@b.SKU</code></td>
                                        <td class="text-center fw-semibold">@b.Quantity</td>
                                        <td class="text-end fw-bold bs-price-current text-nowrap">
                                            @ViewText.FormatVnd(b.Revenue)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
        }
    </div>
</div>

@section Scripts {
    <script src="/js/admin.js"></script>
}

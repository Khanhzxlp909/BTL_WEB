@model ThresholdInput
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = ViewText.T("Ngưỡng cảnh báo tồn kho thấp", "Low-Stock Threshold");
}

@section PageActions {
    <a href="/admin/kho" class="btn btn-sm btn-outline-secondary">
        &larr; @ViewText.T("Danh sách kho", "Back to Inventory")
    </a>
}

@await Html.PartialAsync("_FormErrorBanner", ViewText.T("Không thể lưu ngưỡng tồn kho thấp. Vui lòng kiểm tra trường bên dưới:", "Unable to save low-stock threshold. Please review the field below:"))

<section class="card bs-surface-card">
    <div class="card-body p-4">
        <p class="small text-secondary mb-3">
            @ViewText.T(
                "Đầu sách có số lượng khả dụng (Tồn thực tế trừ Giữ chỗ) nhỏ hơn hoặc bằng ngưỡng này sẽ được đánh dấu cảnh báo tồn kho thấp.",
                "Books whose available quantity (Physical minus Reserved) is less than or equal to this value will trigger a low-stock alert.")
        </p>

        <form method="post"
              action="/admin/kho/nguong"
              asp-antiforgery="true"
              data-prevent-double-submit="true"
              novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-sm-6 col-md-4">
                    <label asp-for="Value" class="form-label fw-semibold">
                        @ViewText.T("Ngưỡng tồn khả dụng thấp (>= 0)", "Low Available Stock Threshold (>= 0)") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Value"
                           type="number"
                           min="0"
                           step="1"
                           inputmode="numeric"
                           class="form-control bs-tabular"
                           required />
                    <div class="form-text small">
                        @ViewText.T("Nhập số nguyên không âm (từ 0 trở lên).", "Enter a non-negative integer (0 or greater).")
                    </div>
                    <span asp-validation-for="Value" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 border-top pt-3 mt-4">
                <a href="/admin/kho" class="btn btn-outline-secondary">
                    @ViewText.T("Hủy", "Cancel")
                </a>
                <button type="submit" class="btn bs-btn-primary px-4">
                    @ViewText.T("Lưu ngưỡng tồn thấp", "Save Threshold")
                </button>
            </div>
        </form>
    </div>
</section>

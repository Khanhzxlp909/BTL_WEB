@model ImportViewModel
@{
    Layout = "_AdminLayout";
    var inv = Model.Inventory;
    ViewData["Title"] = ViewText.T($"Nhập kho sách #{inv.BookId}", $"Import Stock — Book #{inv.BookId}");
    var errorCode = ViewData["ErrorCode"] as string;
    var traceId = ViewData["TraceId"] as string;
    var isStaleVersion = !string.Equals(inv.RowVersion, Model.Input.RowVersion, StringComparison.Ordinal)
        || string.Equals(errorCode, "INVENTORY_CONCURRENCY_CONFLICT", StringComparison.OrdinalIgnoreCase);
    var importConfirmMsg = ViewText.T(
        $"Xác nhận nhập thêm kho cho sách “{inv.Title}” ({inv.SKU})? Thao tác sẽ cộng trực tiếp vào tồn thực tế và lưu lịch sử biến động.",
        $"Confirm importing stock for “{inv.Title}” ({inv.SKU})? This will add to physical stock and record an immutable history entry.");
}

@section PageActions {
    <a href="/admin/kho/@inv.BookId/lich-su" class="btn btn-sm btn-outline-secondary">
        @ViewText.T("Lịch sử biến động", "History")
    </a>
    <a href="/admin/kho" class="btn btn-sm btn-outline-secondary">
        &larr; @ViewText.T("Danh sách kho", "Back to Inventory")
    </a>
}

@if (!ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(errorCode) || isStaleVersion)
{
    <div class="alert alert-danger bs-error-banner mb-4" role="alert">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
            <strong>@ViewText.T("Không thể hoàn tất nhập kho. Vui lòng kiểm tra chi tiết bên dưới:", "Unable to complete stock import. Please review the details below:")</strong>
            @if (!string.IsNullOrWhiteSpace(errorCode))
            {
                <code class="bs-error-code">@errorCode</code>
            }
        </div>
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="small mb-2"></div>
        }
        @if (isStaleVersion)
        {
            <div class="p-3 rounded-2 bg-warning-subtle text-dark border border-warning small mb-2">
                <div class="fw-semibold mb-1">
                    @ViewText.T(
                        "Số liệu tồn kho trong CSDL đã thay đổi so với phiên bản trên biểu mẫu đang mở.",
                        "Database stock has changed since this form version was opened.")
                </div>
                <div class="mb-2">
                    @ViewText.T(
                        "Hệ thống không tự gửi lại để tránh nhập trùng. Hãy bấm nút tải lại biểu mẫu bên dưới để lấy phiên bản tồn kho mới nhất rồi xác nhận lại.",
                        "The form is not auto-resubmitted to prevent duplicate imports. Click the reload link below to fetch the latest stock version, then confirm again.")
                </div>
                <a href="/admin/kho/@inv.BookId/nhap" class="btn btn-sm btn-warning fw-semibold">
                    @ViewText.T("Tải lại biểu mẫu để nhận phiên bản mới", "Reload form to obtain the latest version")
                </a>
            </div>
        }
        else
        {
            <div class="mt-2">
                <a href="/admin/kho/@inv.BookId/nhap" class="btn btn-sm btn-outline-danger">
                    @ViewText.T("Tải lại biểu mẫu nhập kho mới", "Reload fresh import form")
                </a>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(traceId))
        {
            <div class="small text-secondary mt-2">
                @ViewText.T("Mã tra cứu (TraceId):", "Reference ID (TraceId):") <code>@traceId</code>
            </div>
        }
    </div>
}

<section class="card bs-surface-card mb-4" aria-label="@ViewText.T("Thông tin tồn kho hiện tại", "Current book stock summary")">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
            <div>
                <div class="small text-secondary bs-tabular">@ViewText.T("Đầu sách", "Book") #@inv.BookId &middot; <code>@inv.SKU</code></div>
                <h2 class="h5 fw-bold mb-0 d-flex flex-wrap align-items-center gap-2">
                    <span>@inv.Title</span>
                    @if (inv.IsDeleted)
                    {
                        <span class="badge bs-badge-deleted">@ViewText.T("Ngừng bán", "Stopped")</span>
                    }
                    else
                    {
                        <span class="badge bs-badge-instock">@ViewText.T("Đang bán", "Active")</span>
                    }
                </h2>
            </div>
            <a href="/admin/kho/@inv.BookId/nhap" class="btn btn-sm btn-outline-secondary">
                @ViewText.T("Làm mới số liệu", "Refresh Stock Data")
            </a>
        </div>

        <div class="row g-3">
            <div class="col-12 col-sm-4">
                <div class="bs-stock-pill h-100">
                    <div class="small text-secondary">@ViewText.T("Tồn thực tế (Quantity)", "Physical Stock (Quantity)")</div>
                    <div class="fs-4 fw-bold bs-tabular">@inv.Quantity</div>
                </div>
            </div>
            <div class="col-12 col-sm-4">
                <div class="bs-stock-pill h-100">
                    <div class="small text-secondary">@ViewText.T("Đang giữ chỗ (Reserved)", "Reserved Stock")</div>
                    <div class="fs-4 fw-bold text-secondary bs-tabular">@inv.ReservedQuantity</div>
                </div>
            </div>
            <div class="col-12 col-sm-4">
                <div class="bs-stock-pill h-100">
                    <div class="small text-secondary">@ViewText.T("Khả dụng (Available)", "Available Stock")</div>
                    <div class="fs-4 fw-bold bs-tabular @(inv.AvailableQuantity > 0 ? "text-success" : "text-danger")">@inv.AvailableQuantity</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="card bs-surface-card" aria-label="@ViewText.T("Biểu mẫu nhập kho", "Stock import form")">
    <div class="card-body p-4">
        <form method="post"
              action="/admin/kho/@inv.BookId/nhap"
              asp-antiforgery="true"
              data-confirm="@importConfirmMsg"
              data-prevent-double-submit="true"
              novalidate>
            <input type="hidden" name="Input.RowVersion" value="@Model.Input.RowVersion" />
            <span asp-validation-for="Input.RowVersion" class="text-danger small d-block mb-2"></span>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="Input.Quantity" class="form-label fw-semibold">
                        @ViewText.T("Số lượng nhập thêm", "Import Quantity") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Quantity"
                           type="number"
                           min="1"
                           step="1"
                           inputmode="numeric"
                           class="form-control bs-tabular"
                           required />
                    <div class="form-text small">
                        @ViewText.T("Số nguyên dương (>= 1).", "Positive integer (>= 1).")
                    </div>
                    <span asp-validation-for="Input.Quantity" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-8">
                    <label asp-for="Input.Reference" class="form-label fw-semibold">
                        @ViewText.T("Mã phiếu / Chứng từ tham chiếu", "Reference Code") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Input.Reference"
                           class="form-control"
                           maxlength="64"
                           placeholder="@ViewText.T("Ví dụ: PNK-2026-001", "e.g., IMP-2026-001")"
                           required />
                    <span asp-validation-for="Input.Reference" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Reason" class="form-label fw-semibold">
                        @ViewText.T("Lý do / Ghi chú nhập kho", "Import Reason / Note") <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Input.Reason"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              placeholder="@ViewText.T("Nhập chi tiết lô sách, nhà cung cấp hoặc lý do bổ sung tồn kho...", "Describe supplier batch or reason for restocking...")"
                              required></textarea>
                    <div class="form-text small">
                        @ViewText.T("Tối đa 500 ký tự.", "Up to 500 characters.")
                    </div>
                    <span asp-validation-for="Input.Reason" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 border-top pt-3 mt-4">
                <a href="/admin/kho" class="btn btn-outline-secondary">
                    @ViewText.T("Hủy", "Cancel")
                </a>
                <button type="submit" class="btn bs-btn-primary px-4">
                    @ViewText.T("Xác nhận nhập kho", "Confirm Stock Import")
                </button>
            </div>
        </form>
    </div>
</section>

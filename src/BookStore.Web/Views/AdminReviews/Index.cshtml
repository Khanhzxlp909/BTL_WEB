@model ReviewListViewModel
@{
    ViewData["Title"] = ViewText.T("Kiểm duyệt đánh giá", "Moderate Reviews");
    var q = Model.Query;
    var pageSizes = new[] { 12, 24, 48 };

    string BuildPageUrl(int targetPage)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(q.Search))
        {
            parts.Add($"Search={Uri.EscapeDataString(q.Search)}");
        }
        if (q.BookId.HasValue)
        {
            parts.Add($"BookId={q.BookId.Value}");
        }
        if (!string.IsNullOrWhiteSpace(q.Visibility) && !string.Equals(q.Visibility, "all", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add($"Visibility={Uri.EscapeDataString(q.Visibility)}");
        }
        if (q.PageSize != 12)
        {
            parts.Add($"PageSize={q.PageSize}");
        }
        parts.Add($"Page={targetPage}");
        return $"/admin/danh-gia?{string.Join("&", parts)}";
    }
}

<div class="row g-4">
    <aside class="col-12 col-lg-3">
        @await Html.PartialAsync("_AdminNav")
    </aside>

    <div class="col-12 col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h3 bs-serif-heading mb-1">
                    @ViewText.T("Kiểm duyệt đánh giá độc giả", "Reader Review Moderation")
                </h1>
                <p class="text-secondary small mb-0">
                    @ViewText.T(
                        "Ẩn hoặc mở hiển thị lại các nhận xét độc giả. Quản trị viên chỉ kiểm duyệt trạng thái hiển thị, không chỉnh sửa nội dung đánh giá.",
                        "Hide or restore visibility of reader reviews. Administrators moderate visibility only without altering review text.")
                </p>
            </div>
        </div>

        @await Html.PartialAsync("_FormErrorBanner", ViewText.T("Không thể thực hiện thao tác kiểm duyệt hoặc lọc đánh giá:", "Unable to moderate or filter reviews:"))

        <section class="card bs-surface-card mb-4" aria-label="@ViewText.T("Bộ lọc đánh giá", "Review filters")">
            <div class="card-body p-3 p-lg-4">
                <form method="get" action="/admin/danh-gia" data-admin-filter-form="true" novalidate>
                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-5 col-xl-4">
                            <label for="review-filter-search" class="form-label small fw-semibold mb-1">
                                @ViewText.T("Từ khóa tìm kiếm", "Keyword")
                            </label>
                            <input id="review-filter-search"
                                   type="search"
                                   name="Search"
                                   value="@q.Search"
                                   maxlength="255"
                                   class="form-control form-control-sm"
                                   placeholder="@ViewText.T("Tên sách, người dùng, nội dung...", "Book title, user, comment...")" />
                        </div>

                        <div class="col-6 col-md-3 col-xl-2">
                            <label for="review-filter-bookid" class="form-label small fw-semibold mb-1">
                                @ViewText.T("Mã sách (ID)", "Book ID")
                            </label>
                            <input id="review-filter-bookid"
                                   type="number"
                                   name="BookId"
                                   value="@(q.BookId?.ToString(CultureInfo.InvariantCulture))"
                                   min="1"
                                   step="1"
                                   class="form-control form-control-sm"
                                   placeholder="VD: 1" />
                        </div>

                        <div class="col-6 col-md-4 col-xl-3">
                            <label for="review-filter-visibility" class="form-label small fw-semibold mb-1">
                                @ViewText.T("Trạng thái hiển thị", "Visibility")
                            </label>
                            <select id="review-filter-visibility"
                                    name="Visibility"
                                    data-auto-submit="true"
                                    class="form-select form-select-sm">
                                <option value="all" selected="@(q.Visibility == "all")">@ViewText.T("Tất cả", "All")</option>
                                <option value="visible" selected="@(q.Visibility == "visible")">@ViewText.T("Đang hiển thị", "Visible")</option>
                                <option value="hidden" selected="@(q.Visibility == "hidden")">@ViewText.T("Đang ẩn", "Hidden")</option>
                            </select>
                        </div>

                        <div class="col-6 col-sm-4 col-xl-3">
                            <label for="review-filter-pagesize" class="form-label small fw-semibold mb-1">
                                @ViewText.T("Số mục / trang", "Per page")
                            </label>
                            <select id="review-filter-pagesize"
                                    name="PageSize"
                                    data-auto-submit="true"
                                    class="form-select form-select-sm">
                                @foreach (var size in pageSizes)
                                {
                                    <option value="@size" selected="@(q.PageSize == size)">@size</option>
                                }
                                @if (!pageSizes.Contains(q.PageSize) && q.PageSize is >= 1 and <= 100)
                                {
                                    <option value="@q.PageSize" selected>@q.PageSize</option>
                                }
                            </select>
                        </div>

                        <div class="col-6 col-sm-8 col-xl-12 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-sm bs-btn-primary px-3">
                                @ViewText.T("Lọc đánh giá", "Apply Filters")
                            </button>
                            <a href="/admin/danh-gia" class="btn btn-sm btn-outline-secondary">
                                @ViewText.T("Đặt lại", "Reset")
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        <section class="card bs-surface-card">
            <div class="card-body p-0">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 p-lg-4 border-bottom">
                    <h2 class="h5 bs-serif-heading mb-0">
                        @ViewText.T("Danh sách đánh giá", "Reviews List")
                    </h2>
                    <span class="badge text-bg-light border">
                        @Model.Reviews.TotalItems @ViewText.T("đánh giá", "reviews")
                    </span>
                </div>

                @if (Model.Reviews.Items.Count == 0)
                {
                    <div class="p-4 text-center text-secondary">
                        @ViewText.T(
                            "Không có đánh giá nào khớp với bộ lọc hiện tại.",
                            "No reviews match the current filter criteria.")
                    </div>
                }
                else
                {
                    <div class="bs-admin-table-wrap">
                        <table class="table bs-admin-table mb-0">
                            <thead>
                                <tr>
                                    <th>@ViewText.T("Sách & Độc giả", "Book & Reader")</th>
                                    <th>@ViewText.T("Điểm", "Rating")</th>
                                    <th>@ViewText.T("Nội dung nhận xét", "Comment")</th>
                                    <th>@ViewText.T("Trạng thái", "Visibility")</th>
                                    <th class="text-end">@ViewText.T("Kiểm duyệt", "Moderation")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Reviews.Items)
                                {
                                    <tr class="@(r.IsHidden ? "table-light" : "")">
                                        <td class="bs-wrap-anywhere">
                                            <a href="/sach/@r.BookId" class="fw-semibold text-decoration-none d-block">
                                                @r.BookTitle
                                            </a>
                                            <div class="small text-secondary mt-1">
                                                <span>#@r.BookId</span> &middot;
                                                <span>@ViewText.T("Độc giả:", "User:") <strong class="text-dark">@r.UserName</strong></span>
                                            </div>
                                            <div class="small text-muted">
                                                @ViewText.T("Tạo:", "Created:") @ViewText.FormatVietnamTime(r.CreatedAt)
                                            </div>
                                            @if (r.UpdatedAt > r.CreatedAt.AddSeconds(1))
                                            {
                                                <div class="small text-muted">
                                                    @ViewText.T("Sửa:", "Updated:") @ViewText.FormatVietnamTime(r.UpdatedAt)
                                                </div>
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            <span class="badge bs-badge-rating">@r.Rating / 5</span>
                                        </td>
                                        <td class="bs-preline bs-wrap-anywhere">@r.Comment</td>
                                        <td>
                                            @if (r.IsHidden)
                                            {
                                                <span class="badge bs-badge-hidden-review">
                                                    @ViewText.T("Đang ẩn", "Hidden")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bs-badge-instock">
                                                    @ViewText.T("Đang hiển thị", "Visible")
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.ModeratedBy) || r.ModeratedAt.HasValue)
                                            {
                                                <div class="small text-muted mt-1">
                                                    @if (!string.IsNullOrWhiteSpace(r.ModeratedBy))
                                                    {
                                                        <div>@ViewText.T("Bởi:", "By:") @r.ModeratedBy</div>
                                                    }
                                                    @if (r.ModeratedAt.HasValue)
                                                    {
                                                        <div>@ViewText.FormatVietnamTime(r.ModeratedAt.Value)</div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (r.IsHidden)
                                            {
                                                <form method="post"
                                                      action="/admin/danh-gia/@r.Id/hien"
                                                      asp-antiforgery="true"
                                                      data-confirm="@ViewText.T($"Xác nhận mở hiển thị lại đánh giá #{r.Id} của \"{r.UserName}\" trên trang sách?", $"Confirm restoring public visibility for review #{r.Id} by \"{r.UserName}\"?")"
                                                      data-prevent-double-submit="true"
                                                      class="d-inline">
                                                    <button type="submit" class="btn btn-sm bs-btn-primary">
                                                        @ViewText.T("Hiện đánh giá", "Show")
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post"
                                                      action="/admin/danh-gia/@r.Id/an"
                                                      asp-antiforgery="true"
                                                      data-confirm="@ViewText.T($"Xác nhận ẩn đánh giá #{r.Id} của \"{r.UserName}\" khỏi trang công khai?", $"Confirm hiding review #{r.Id} by \"{r.UserName}\" from public view?")"
                                                      data-prevent-double-submit="true"
                                                      class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        @ViewText.T("Ẩn đánh giá", "Hide")
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        @if (Model.Reviews.TotalPages > 1)
        {
            var currentPage = Model.Reviews.Page;
            var totalPages = Model.Reviews.TotalPages;
            var startPage = Math.Max(1, currentPage - 2);
            var endPage = Math.Min(totalPages, currentPage + 2);

            <nav class="mt-4" aria-label="@ViewText.T("Phân trang danh sách đánh giá", "Reviews pagination")">
                <ul class="pagination justify-content-center flex-wrap mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@(currentPage <= 1 ? "#" : BuildPageUrl(currentPage - 1))"
                           tabindex="@(currentPage <= 1 ? "-1" : null)"
                           aria-disabled="@(currentPage <= 1 ? "true" : null)">
                            @ViewText.T("Trước", "Previous")
                        </a>
                    </li>
                    @if (startPage > 1)
                    {
                        <li class="page-item"><a class="page-link" href="@BuildPageUrl(1)">1</a></li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    @for (var p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")" aria-current="@(p == currentPage ? "page" : null)">
                            <a class="page-link" href="@BuildPageUrl(p)">@p</a>
                        </li>
                    }
                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        <li class="page-item"><a class="page-link" href="@BuildPageUrl(totalPages)">@totalPages</a></li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@(currentPage >= totalPages ? "#" : BuildPageUrl(currentPage + 1))"
                           tabindex="@(currentPage >= totalPages ? "-1" : null)"
                           aria-disabled="@(currentPage >= totalPages ? "true" : null)">
                            @ViewText.T("Tiếp", "Next")
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script src="/js/admin.js"></script>
}

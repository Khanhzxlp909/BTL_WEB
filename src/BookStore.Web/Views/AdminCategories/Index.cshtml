@model CategoryListViewModel
@{
    ViewData["Title"] = ViewText.T("Quản trị thể loại sách", "Book Categories Management");
    var q = Model.Query;
    var presetPageSizes = new[] { 8, 12, 24, 48, 100 };
    var errorCode = ViewData["ErrorCode"] as string;
    var traceId = ViewData["TraceId"] as string;

    string BuildPageUrl(int targetPage)
    {
        var routeValues = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(q.Search))
        {
            routeValues["Search"] = q.Search;
        }
        routeValues["PageSize"] = q.PageSize.ToString(CultureInfo.InvariantCulture);
        routeValues["Page"] = targetPage.ToString(CultureInfo.InvariantCulture);

        var queryString = string.Join("&", routeValues
            .Where(kv => !string.IsNullOrEmpty(kv.Value))
            .Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value!)}"));
        return string.IsNullOrEmpty(queryString) ? "/admin/the-loai" : $"/admin/the-loai?{queryString}";
    }
}

<div class="row g-4">
    <aside class="col-12 col-lg-3">
        @await Html.PartialAsync("_AdminNav")
    </aside>

    <div class="col-12 col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h3 bs-serif-heading mb-1">@ViewText.T("Quản trị thể loại sách", "Book Categories Management")</h1>
                <p class="text-secondary small mb-0">
                    @ViewText.T(
                        $"Tổng cộng {Model.Categories.TotalItems} thể loại (gồm cả đang hoạt động và đã xóa mềm)",
                        $"Showing {Model.Categories.TotalItems} categories (including active and soft-deleted)")
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/admin/sach" class="btn btn-sm btn-outline-secondary">
                    @ViewText.T("Danh sách sách", "Manage Books")
                </a>
                <a href="/admin/the-loai/them" class="btn btn-sm bs-btn-primary">
                    @ViewText.T("Thêm thể loại mới", "Add New Category")
                </a>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(errorCode))
        {
            <div class="alert alert-danger" role="alert">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                    <strong>@ViewText.T("Tham số lọc hoặc yêu cầu không hợp lệ. Hãy kiểm tra chi tiết bên dưới:", "Invalid filter or request parameters. Please review the details below:")</strong>
                    @if (!string.IsNullOrWhiteSpace(errorCode))
                    {
                        <code class="bs-error-code">@errorCode</code>
                    }
                </div>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="small mb-0"></div>
                }
                @if (!string.IsNullOrWhiteSpace(traceId))
                {
                    <div class="small text-secondary mt-2">
                        @ViewText.T("Mã tra cứu (TraceId):", "Reference ID (TraceId):") <code>@traceId</code>
                    </div>
                }
            </div>
        }

        <section class="card bs-surface-card mb-4" aria-label="@ViewText.T("Bộ lọc thể loại sách", "Category filter form")">
            <div class="card-body p-3 p-lg-4">
                <form id="admin-category-filter-form"
                      method="get"
                      action="/admin/the-loai"
                      data-admin-filter-form="true"
                      class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                        <label for="admin-category-search" class="form-label small fw-semibold">
                            @ViewText.T("Tìm theo tên thể loại", "Search by category name")
                        </label>
                        <input id="admin-category-search"
                               type="search"
                               name="Search"
                               value="@q.Search"
                               maxlength="255"
                               class="form-control form-control-sm"
                               placeholder="@ViewText.T("Nhập tên thể loại cần tìm...", "Enter category name...")" />
                        <span class="text-danger small">@Html.ValidationMessage("Search")</span>
                    </div>

                    <div class="col-6 col-md-3">
                        <label for="admin-category-pagesize" class="form-label small fw-semibold">
                            @ViewText.T("Số dòng/trang", "Per page")
                        </label>
                        <select id="admin-category-pagesize" name="PageSize" class="form-select form-select-sm" data-auto-submit="true">
                            @if (!presetPageSizes.Contains(q.PageSize))
                            {
                                <option value="@q.PageSize" selected>@q.PageSize</option>
                            }
                            @foreach (var size in presetPageSizes)
                            {
                                if (q.PageSize == size)
                                {
                                    <option value="@size" selected>@size</option>
                                }
                                else
                                {
                                    <option value="@size">@size</option>
                                }
                            }
                        </select>
                        <span class="text-danger small">@Html.ValidationMessage("PageSize")</span>
                    </div>

                    <div class="col-6 col-md-3 d-flex gap-2 justify-content-md-end">
                        <button type="submit" class="btn btn-sm bs-btn-primary px-3">
                            @ViewText.T("Lọc", "Apply")
                        </button>
                        <a href="/admin/the-loai" class="btn btn-sm btn-outline-secondary">
                            @ViewText.T("Đặt lại", "Reset")
                        </a>
                    </div>
                </form>
            </div>
        </section>

        <section class="card bs-surface-card" aria-label="@ViewText.T("Bảng danh sách thể loại", "Categories table")">
            <div class="card-body p-0">
                @if (Model.Categories.Items.Count == 0)
                {
                    <div class="p-4 p-lg-5 text-center">
                        <h2 class="h5 bs-serif-heading mb-2">
                            @ViewText.T("Không tìm thấy thể loại phù hợp", "No matching categories found")
                        </h2>
                        <p class="text-secondary small mb-3">
                            @ViewText.T(
                                "Hãy thử từ khóa khác hoặc tạo thể loại mới.",
                                "Try a different keyword or add a new category.")
                        </p>
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a href="/admin/the-loai" class="btn btn-sm btn-outline-secondary">
                                @ViewText.T("Xóa bộ lọc", "Clear Filters")
                            </a>
                            <a href="/admin/the-loai/them" class="btn btn-sm bs-btn-primary">
                                @ViewText.T("Thêm thể loại mới", "Add New Category")
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="bs-admin-table-wrap">
                        <table class="table table-hover bs-admin-table mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>@ViewText.T("Tên thể loại", "Category Name")</th>
                                    <th>@ViewText.T("Mô tả", "Description")</th>
                                    <th class="text-end">@ViewText.T("Số sách", "Books")</th>
                                    <th class="text-center">@ViewText.T("Trạng thái", "Status")</th>
                                    <th class="text-end">@ViewText.T("Thao tác", "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in Model.Categories.Items)
                                {
                                    <tr>
                                        <td class="text-secondary text-nowrap">#@category.Id</td>
                                        <td class="fw-semibold">@category.Name</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(category.Description))
                                            {
                                                <span class="small text-secondary">@category.Description</span>
                                            }
                                            else
                                            {
                                                <span class="small text-muted fst-italic">@ViewText.T("Chưa có mô tả", "No description")</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a href="/admin/sach?CategoryId=@category.Id" class="fw-semibold text-decoration-none">
                                                @category.BookCount
                                            </a>
                                        </td>
                                        <td class="text-center text-nowrap">
                                            @if (category.IsDeleted)
                                            {
                                                <span class="badge bs-badge-deleted">
                                                    @ViewText.T("Đã xóa mềm", "Deleted")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bs-badge-instock">
                                                    @ViewText.T("Đang hoạt động", "Active")
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (!category.IsDeleted)
                                            {
                                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                                    <a href="/admin/the-loai/@category.Id/sua" class="btn btn-sm btn-outline-secondary">
                                                        @ViewText.T("Sửa", "Edit")
                                                    </a>
                                                    <form method="post"
                                                          action="/admin/the-loai/@category.Id/xoa"
                                                          asp-antiforgery="true"
                                                          class="d-inline"
                                                          data-confirm="@ViewText.T($"Xác nhận xóa mềm thể loại \"{category.Name}\" (#{category.Id})? Chỉ thể loại không còn sách tham chiếu mới có thể xóa.", $"Confirm soft-deleting category \"{category.Name}\" (#{category.Id})? Only categories with no referenced books can be deleted.")"
                                                          data-prevent-double-submit="true">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            @ViewText.T("Xóa", "Delete")
                                                        </button>
                                                    </form>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="small text-muted">
                                                    @ViewText.T("Không thao tác", "Locked")
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        @if (Model.Categories.TotalPages > 1)
        {
            var currentPage = Model.Categories.Page;
            var totalPages = Model.Categories.TotalPages;
            var startPage = Math.Max(1, currentPage - 2);
            var endPage = Math.Min(totalPages, currentPage + 2);

            <nav class="mt-4" aria-label="@ViewText.T("Phân trang danh sách thể loại", "Categories pagination")">
                <ul class="pagination justify-content-center flex-wrap mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@(currentPage <= 1 ? "#" : BuildPageUrl(currentPage - 1))"
                           tabindex="@(currentPage <= 1 ? "-1" : null)"
                           aria-disabled="@(currentPage <= 1 ? "true" : null)">
                            @ViewText.T("Trước", "Previous")
                        </a>
                    </li>

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@BuildPageUrl(1)">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }

                    @for (var p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")" aria-current="@(p == currentPage ? "page" : null)">
                            <a class="page-link" href="@BuildPageUrl(p)">@p</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@BuildPageUrl(totalPages)">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="@(currentPage >= totalPages ? "#" : BuildPageUrl(currentPage + 1))"
                           tabindex="@(currentPage >= totalPages ? "-1" : null)"
                           aria-disabled="@(currentPage >= totalPages ? "true" : null)">
                            @ViewText.T("Tiếp", "Next")
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script src="/js/admin.js"></script>
}

@model CartDto
@{
    ViewData["Title"] = ViewText.T("Giỏ hàng", "Shopping Cart");
    var hasItems = Model.Items.Count > 0;
    var hasPriceChanged = Model.Items.Any(x => x.PriceChanged);
    var hasUnavailable = Model.Items.Any(x => !x.IsAvailable);
    var warningItems = Model.Items.Where(x => !string.IsNullOrWhiteSpace(x.Warning)).ToList();
    var clearConfirmText = ViewText.T(
        "Bạn có chắc chắn muốn làm trống toàn bộ giỏ hàng?",
        "Are you sure you want to remove all items from your cart?");
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">@ViewText.T("Trang chủ", "Home")</a></li>
        <li class="breadcrumb-item"><a href="/sach" class="text-decoration-none">@ViewText.T("Danh mục sách", "Books")</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewText.T("Giỏ hàng", "Cart")</li>
    </ol>
</nav>

<div id="bs-cart-page" data-cart-item-count="@Model.ItemCount">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 bs-serif-heading fw-bold mb-0">
            @ViewText.T("Giỏ hàng của bạn", "Your Shopping Cart")
        </h1>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-cart-refresh="true">
            @ViewText.T("Làm mới giỏ hàng", "Refresh Cart")
        </button>
    </div>

    <div id="bs-cart-ajax-alert" class="d-none mb-3"></div>

    <div id="bs-cart-observation-banner">
        @if (hasItems)
        {
            @if (hasPriceChanged || hasUnavailable || warningItems.Count > 0)
            {
                <div class="alert alert-warning mb-3" role="status">
                    <div class="fw-semibold mb-1">
                        @(hasPriceChanged
                            ? ViewText.T("Cảnh báo cập nhật giá / tồn kho trong giỏ hàng:", "Price or stock changes detected in your cart:")
                            : ViewText.T("Cảnh báo tình trạng sách trong giỏ hàng:", "Cart item availability notice:"))
                    </div>
                    @if (warningItems.Count > 0)
                    {
                        <ul class="small mb-1 ps-3">
                            @foreach (var w in warningItems)
                            {
                                <li><strong>@w.Title:</strong> @w.Warning</li>
                            }
                        </ul>
                    }
                    <div class="small">
                        @ViewText.T(
                            "Vui lòng kiểm tra lại đơn giá, điều chỉnh số lượng hoặc xóa mục không khả dụng trước khi chuyển sang Đặt hàng.",
                            "Please review unit prices and adjust or remove unavailable items before proceeding to Checkout.")
                    </div>
                </div>
            }

            @if (!hasPriceChanged)
            {
                <div class="alert alert-light border small text-secondary mb-3" role="note">
                    @ViewText.T(
                        "Lưu ý giá tham khảo: Đơn giá hiển thị là giá bán hiện tại. Báo giá cuối cùng và thanh toán COD sẽ được xác nhận lại tại bước Đặt hàng.",
                        "Reference price notice: Displayed unit prices reflect current live prices. Final quotation and COD payment are re-verified at Checkout.")
                </div>
            }
        }
    </div>

    <section id="bs-cart-empty" class="bs-empty-state @(hasItems ? "d-none" : "")">
        <h2 class="h5 fw-bold mb-2">
            @ViewText.T("Giỏ hàng của bạn đang trống", "Your cart is currently empty")
        </h2>
        <p class="text-secondary small mb-4">
            @ViewText.T(
                "Hãy chọn những đầu sách yêu thích từ danh mục để bắt đầu đặt hàng.",
                "Explore our catalog and add books to your cart to start ordering.")
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a href="/sach" class="btn bs-btn-primary px-4">
                @ViewText.T("Tiếp tục mua sắm", "Continue Shopping")
            </a>
            <a href="/don-hang" class="btn btn-outline-secondary">
                @ViewText.T("Đơn hàng của tôi", "My Orders")
            </a>
        </div>
    </section>

    <div id="bs-cart-filled" class="row g-4 @(hasItems ? "" : "d-none")">
        <div class="col-12 col-lg-8">
            <section class="card bs-surface-card" aria-label="@ViewText.T("Danh sách sản phẩm trong giỏ", "Cart items")">
                <div class="card-body p-0">
                    <table class="table align-middle bs-cart-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-md-3">@ViewText.T("Sách", "Book")</th>
                                <th class="text-md-end">@ViewText.T("Đơn giá", "Unit Price")</th>
                                <th class="text-md-center">@ViewText.T("Số lượng", "Quantity")</th>
                                <th class="text-md-end">@ViewText.T("Thành tiền", "Line Total")</th>
                                <th class="text-md-end pe-md-3">@ViewText.T("Thao tác", "Action")</th>
                            </tr>
                        </thead>
                        <tbody id="bs-cart-tbody">
                            @foreach (var line in Model.Items)
                            {
                                var detailUrl = $"/sach/{line.BookId}";
                                var lineQtyLabel = ViewText.T($"Số lượng của {line.Title}", $"Quantity for {line.Title}");
                                <tr data-cart-line-id="@line.Id" class="@(!line.IsAvailable ? "table-warning" : "")">
                                    <td class="bs-cart-cell-book ps-md-3">
                                        <div class="d-flex align-items-start gap-3 w-100">
                                            <a href="@detailUrl" class="text-decoration-none">
                                                @if (!string.IsNullOrWhiteSpace(line.CoverImage))
                                                {
                                                    <img src="@line.CoverImage" alt="@line.Title" class="bs-cart-thumb" />
                                                }
                                                else
                                                {
                                                    <span class="bs-cart-thumb-placeholder">@line.SKU</span>
                                                }
                                            </a>
                                            <div class="min-w-0 flex-grow-1">
                                                <a href="@detailUrl" class="fw-semibold text-decoration-none text-dark d-block bs-wrap-anywhere">@line.Title</a>
                                                <div class="small text-muted mt-1 d-flex flex-wrap align-items-center gap-2">
                                                    <span>SKU: <code>@line.SKU</code></span>
                                                    @if (line.IsAvailable && line.AvailableQuantity > 0)
                                                    {
                                                        <span class="badge bs-badge-instock bs-tabular">
                                                            @ViewText.T($"Khả dụng: {line.AvailableQuantity}", $"Available: {line.AvailableQuantity}")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bs-badge-outstock">
                                                            @ViewText.T("Không đủ hàng / Ngừng bán", "Unavailable / Out of stock")
                                                        </span>
                                                    }
                                                    @if (line.PriceChanged)
                                                    {
                                                        <span class="badge bs-badge-price-changed">
                                                            @ViewText.T("Giá vừa thay đổi", "Price changed")
                                                        </span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(line.Warning))
                                                {
                                                    <div class="small text-danger fw-medium mt-1 bs-wrap-anywhere">@line.Warning</div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="@ViewText.T("Đơn giá", "Unit Price")" class="text-md-end text-nowrap fw-medium bs-tabular">
                                        @ViewText.FormatVnd(line.UnitPrice)
                                    </td>
                                    <td data-label="@ViewText.T("Số lượng", "Quantity")" class="text-md-center">
                                        <div class="bs-qty-stepper">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-cart-step="-1"
                                                    data-line-id="@line.Id"
                                                    disabled="@(line.Quantity <= 1 ? "disabled" : null)"
                                                    aria-label="@ViewText.T("Giảm số lượng", "Decrease quantity")">&minus;</button>
                                            <input type="number"
                                                   min="0"
                                                   max="@(line.AvailableQuantity > 0 ? line.AvailableQuantity : null)"
                                                   step="1"
                                                   inputmode="numeric"
                                                   value="@line.Quantity"
                                                   data-cart-qty-input="true"
                                                   data-prev-qty="@line.Quantity"
                                                   data-line-id="@line.Id"
                                                   aria-label="@lineQtyLabel"
                                                   class="form-control form-control-sm bs-qty-input" />
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-cart-step="1"
                                                    data-line-id="@line.Id"
                                                    disabled="@(line.AvailableQuantity > 0 && line.Quantity >= line.AvailableQuantity ? "disabled" : null)"
                                                    aria-label="@ViewText.T("Tăng số lượng", "Increase quantity")">+</button>
                                        </div>
                                    </td>
                                    <td data-label="@ViewText.T("Thành tiền", "Line Total")" class="text-md-end text-nowrap fw-bold bs-price-current">
                                        @ViewText.FormatVnd(line.LineTotal)
                                    </td>
                                    <td data-label="@ViewText.T("Thao tác", "Action")" class="text-md-end text-nowrap pe-md-3">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-cart-remove="true"
                                                data-line-id="@line.Id">
                                            @ViewText.T("Xóa", "Remove")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-transparent border-top p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <a href="/sach" class="btn btn-sm btn-outline-secondary">
                        &larr; @ViewText.T("Tiếp tục mua sắm", "Continue Shopping")
                    </a>
                    <button type="button"
                            id="bs-cart-clear-btn"
                            class="btn btn-sm btn-outline-danger"
                            data-confirm="@clearConfirmText">
                        @ViewText.T("Làm trống giỏ hàng", "Clear Cart")
                    </button>
                </div>
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="card bs-surface-card bs-cart-summary-card bs-cart-summary-sticky" aria-labelledby="cart-summary-heading">
                <div class="card-body p-4">
                    <h2 id="cart-summary-heading" class="h6 fw-bold mb-3">
                        @ViewText.T("Tóm tắt đơn hàng", "Order Summary")
                    </h2>

                    <div class="d-flex justify-content-between small mb-2 bs-tabular">
                        <span class="text-secondary">@ViewText.T("Tổng số lượng sách:", "Total quantity:")</span>
                        <strong id="bs-cart-summary-count">@Model.ItemCount</strong>
                    </div>

                    <div class="d-flex justify-content-between small mb-2 bs-tabular">
                        <span class="text-secondary">@ViewText.T("Tạm tính:", "Subtotal:")</span>
                        <span id="bs-cart-subtotal">@ViewText.FormatVnd(Model.Subtotal)</span>
                    </div>

                    <div class="d-flex justify-content-between small mb-2 bs-tabular">
                        <span class="text-secondary">@ViewText.T("Phí giao hàng:", "Shipping fee:")</span>
                        <span id="bs-cart-shipping">@ViewText.FormatVnd(Model.ShippingFee)</span>
                    </div>

                    <div class="d-flex justify-content-between small mb-3">
                        <span class="text-secondary">@ViewText.T("Thanh toán:", "Payment:")</span>
                        <span class="fw-semibold">COD (@ViewText.T("Khi nhận hàng", "Cash on Delivery"))</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline border-top pt-3 mb-3 bs-tabular">
                        <span class="fw-bold">@ViewText.T("Tổng cộng:", "Total:")</span>
                        <span id="bs-cart-total" class="fs-4 fw-bold bs-price-current">@ViewText.FormatVnd(Model.TotalAmount)</span>
                    </div>

                    <div id="bs-cart-cannot-checkout" class="alert alert-warning small py-2 px-3 mb-3 @(Model.CanCheckout ? "d-none" : "")">
                        @ViewText.T(
                            "Giỏ hàng đang có mục hết hàng, ngừng bán hoặc vượt số lượng khả dụng. Hãy điều chỉnh hoặc xóa trước khi đặt hàng.",
                            "Your cart contains unavailable items or quantities exceeding stock. Adjust or remove them before checking out.")
                    </div>

                    <div class="d-grid gap-2">
                        <a id="bs-cart-checkout-link"
                           href="/dat-hang"
                           class="btn bs-btn-primary py-2 @(Model.CanCheckout ? "" : "disabled pe-none opacity-50")"
                           aria-disabled="@(Model.CanCheckout ? "false" : "true")"
                           tabindex="@(Model.CanCheckout ? null : "-1")">
                            @ViewText.T("Tiến hành đặt hàng", "Proceed to Checkout")
                        </a>
                        <a href="/don-hang" class="btn btn-outline-secondary btn-sm">
                            @ViewText.T("Đơn hàng của tôi", "My Orders")
                        </a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

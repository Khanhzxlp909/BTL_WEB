@model OrderListViewModel
@{
    var q = Model.Query;
    var baseUrl = Model.IsAdmin ? "/admin/don-hang" : "/don-hang";
    var pageSizes = new[] { 12, 24, 48 };
    var allStatuses = Enum.GetValues<OrderStatus>();

    string BuildPageUrl(int targetPage)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(q.Search))
        {
            parts.Add($"Search={Uri.EscapeDataString(q.Search)}");
        }
        if (Model.IsAdmin && !string.IsNullOrWhiteSpace(q.Customer))
        {
            parts.Add($"Customer={Uri.EscapeDataString(q.Customer)}");
        }
        if (q.Status.HasValue)
        {
            parts.Add($"Status={Uri.EscapeDataString(q.Status.Value.ToString())}");
        }
        if (q.FromDate.HasValue)
        {
            parts.Add($"FromDate={q.FromDate.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
        }
        if (q.ToDate.HasValue)
        {
            parts.Add($"ToDate={q.ToDate.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}");
        }
        if (q.PageSize != 12)
        {
            parts.Add($"PageSize={q.PageSize}");
        }
        parts.Add($"Page={targetPage}");
        return $"{baseUrl}?{string.Join("&", parts)}";
    }
}

@await Html.PartialAsync("_FormErrorBanner", ViewText.T("Bộ lọc đơn hàng không hợp lệ. Hãy kiểm tra điều kiện lọc:", "Invalid order filter parameters. Check your filter values:"))

<section class="card bs-surface-card mb-4" aria-label="@ViewText.T("Bộ lọc đơn hàng", "Order filters")">
    <div class="card-body p-3 p-lg-4">
        <form method="get"
              action="@baseUrl"
              data-admin-filter-form="true"
              data-customer-filter-form="true"
              novalidate>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6 @(Model.IsAdmin ? "col-xl-3" : "col-xl-4")">
                    <label for="order-filter-search" class="form-label small fw-semibold mb-1">
                        @ViewText.T("Mã đơn hàng", "Order Code")
                    </label>
                    <input id="order-filter-search"
                           type="search"
                           name="Search"
                           value="@q.Search"
                           maxlength="255"
                           class="form-control form-control-sm"
                           placeholder="@ViewText.T("VD: DH2026...", "e.g. ORD / DH...")" />
                </div>

                @if (Model.IsAdmin)
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <label for="order-filter-customer" class="form-label small fw-semibold mb-1">
                            @ViewText.T("Khách hàng", "Customer")
                        </label>
                        <input id="order-filter-customer"
                               type="search"
                               name="Customer"
                               value="@q.Customer"
                               maxlength="100"
                               class="form-control form-control-sm"
                               placeholder="@ViewText.T("Tên đăng nhập / người nhận...", "Username or recipient...")" />
                    </div>
                }

                <div class="col-12 col-sm-6 @(Model.IsAdmin ? "col-xl-2" : "col-xl-3")">
                    <label for="order-filter-status" class="form-label small fw-semibold mb-1">
                        @ViewText.T("Trạng thái", "Status")
                    </label>
                    <select id="order-filter-status"
                            name="Status"
                            data-auto-submit="true"
                            class="form-select form-select-sm">
                        <option value="">@ViewText.T("Tất cả trạng thái", "All statuses")</option>
                        @foreach (var status in allStatuses)
                        {
                            <option value="@status" selected="@(q.Status == status)">
                                @await Html.PartialAsync("_OrderStatusText", status)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-6 col-sm-3 col-xl-2">
                    <label for="order-filter-from" class="form-label small fw-semibold mb-1">
                        @ViewText.T("Từ ngày", "From date")
                    </label>
                    <input id="order-filter-from"
                           type="date"
                           name="FromDate"
                           value="@(q.FromDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"
                           class="form-control form-control-sm" />
                </div>

                <div class="col-6 col-sm-3 col-xl-2">
                    <label for="order-filter-to" class="form-label small fw-semibold mb-1">
                        @ViewText.T("Đến ngày", "To date")
                    </label>
                    <input id="order-filter-to"
                           type="date"
                           name="ToDate"
                           value="@(q.ToDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture))"
                           class="form-control form-control-sm" />
                </div>

                <div class="col-6 col-sm-4 col-md-3">
                    <label for="order-filter-pagesize" class="form-label small fw-semibold mb-1">
                        @ViewText.T("Số dòng / trang", "Per page")
                    </label>
                    <select id="order-filter-pagesize"
                            name="PageSize"
                            data-auto-submit="true"
                            class="form-select form-select-sm">
                        @foreach (var size in pageSizes)
                        {
                            <option value="@size" selected="@(q.PageSize == size)">@size</option>
                        }
                        @if (!pageSizes.Contains(q.PageSize) && q.PageSize is >= 1 and <= 100)
                        {
                            <option value="@q.PageSize" selected>@q.PageSize</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-sm-8 col-md-9 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-sm bs-btn-primary px-3">
                        @ViewText.T("Lọc đơn hàng", "Filter")
                    </button>
                    <a href="@baseUrl" class="btn btn-sm btn-outline-secondary">
                        @ViewText.T("Đặt lại", "Reset")
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>

<section class="card bs-surface-card">
    <div class="card-body p-0">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 p-lg-4 border-bottom">
            <h2 class="h5 bs-serif-heading mb-0">
                @(Model.IsAdmin
                    ? ViewText.T("Danh sách đơn hàng hệ thống", "System Orders")
                    : ViewText.T("Danh sách đơn hàng của bạn", "Your Orders"))
            </h2>
            <span class="badge text-bg-light border">
                @Model.Orders.TotalItems @ViewText.T("đơn hàng", "orders")
            </span>
        </div>

        @if (Model.Orders.Items.Count == 0)
        {
            <div class="p-4 text-center">
                <p class="text-secondary mb-3">
                    @ViewText.T(
                        "Không có đơn hàng nào khớp với điều kiện tra cứu hiện tại.",
                        "No orders match the current filter criteria.")
                </p>
                @if (!Model.IsAdmin)
                {
                    <a href="/sach" class="btn btn-sm bs-btn-primary">
                        @ViewText.T("Khám phá danh mục sách", "Browse Catalog")
                    </a>
                }
            </div>
        }
        else
        {
            <div class="bs-admin-table-wrap">
                <table class="table table-hover bs-admin-table mb-0">
                    <thead>
                        <tr>
                            <th>@ViewText.T("Mã đơn", "Order Code")</th>
                            @if (Model.IsAdmin)
                            {
                                <th>@ViewText.T("Tài khoản", "Customer")</th>
                            }
                            <th>@ViewText.T("Thời gian đặt", "Created At")</th>
                            <th>@ViewText.T("Trạng thái đơn", "Order Status")</th>
                            <th>@ViewText.T("Thanh toán", "Payment")</th>
                            <th class="text-end">@ViewText.T("Tổng tiền", "Total")</th>
                            <th class="text-end">@ViewText.T("Thao tác", "Action")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Orders.Items)
                        {
                            var detailUrl = $"{baseUrl}/{item.Id}";
                            <tr>
                                <td class="fw-semibold text-nowrap">
                                    <a href="@detailUrl" class="text-decoration-none">
                                        <code>@item.OrderCode</code>
                                    </a>
                                </td>
                                @if (Model.IsAdmin)
                                {
                                    <td>@item.UserName</td>
                                }
                                <td class="text-nowrap small text-secondary">
                                    @ViewText.FormatVietnamTime(item.CreatedAt)
                                </td>
                                <td>
                                    @await Html.PartialAsync("_OrderStatusBadge", item.Status)
                                </td>
                                <td>
                                    @await Html.PartialAsync("_PaymentStatusBadge", item.PaymentStatus)
                                </td>
                                <td class="text-end fw-bold bs-price-current text-nowrap">
                                    @ViewText.FormatVnd(item.TotalAmount)
                                </td>
                                <td class="text-end text-nowrap">
                                    <a href="@detailUrl" class="btn btn-sm btn-outline-secondary">
                                        @ViewText.T("Chi tiết", "Details")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@if (Model.Orders.TotalPages > 1)
{
    var currentPage = Model.Orders.Page;
    var totalPages = Model.Orders.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    <nav class="mt-4" aria-label="@ViewText.T("Phân trang danh sách đơn hàng", "Orders pagination")">
        <ul class="pagination justify-content-center flex-wrap mb-0">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@(currentPage <= 1 ? "#" : BuildPageUrl(currentPage - 1))"
                   tabindex="@(currentPage <= 1 ? "-1" : null)"
                   aria-disabled="@(currentPage <= 1 ? "true" : null)">
                    @ViewText.T("Trước", "Previous")
                </a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@BuildPageUrl(1)">1</a>
                </li>
                @if (startPage > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }

            @for (var p = startPage; p <= endPage; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")" aria-current="@(p == currentPage ? "page" : null)">
                    <a class="page-link" href="@BuildPageUrl(p)">@p</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                @if (endPage < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item">
                    <a class="page-link" href="@BuildPageUrl(totalPages)">@totalPages</a>
                </li>
            }

            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   href="@(currentPage >= totalPages ? "#" : BuildPageUrl(currentPage + 1))"
                   tabindex="@(currentPage >= totalPages ? "-1" : null)"
                   aria-disabled="@(currentPage >= totalPages ? "true" : null)">
                    @ViewText.T("Tiếp", "Next")
                </a>
            </li>
        </ul>
    </nav>
}

@model ErrorViewModel
@{
    ViewData["Title"] = ViewText.T($"Lỗi {Model.StatusCode}", $"Error {Model.StatusCode}");
}
<section class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card bs-surface-card">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="mb-3">
                    <span class="badge bs-badge-outstock fs-6">HTTP @Model.StatusCode</span>
                </div>

                <h1 class="h4 bs-serif-heading mb-2">
                    @ViewText.T("Không thể hoàn tất yêu cầu", "Unable to Complete Request")
                </h1>

                <p class="text-secondary mb-4">
                    @Model.Message
                </p>

                <div class="bg-light border rounded-2 p-3 mb-4 text-start small">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary">@ViewText.T("Mã lỗi", "Error Code")</span>
                        <code class="bs-error-code">@Model.Code</code>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-secondary">@ViewText.T("Mã tra cứu (TraceId)", "Reference ID (TraceId)")</span>
                        <code id="error-trace-id">@Model.TraceId</code>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a href="/" class="btn bs-btn-primary px-4">
                        @ViewText.T("Về trang chủ", "Back to Home")
                    </a>
                    <a href="/sach" class="btn btn-outline-secondary">
                        @ViewText.T("Xem danh mục sách", "Browse Catalog")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

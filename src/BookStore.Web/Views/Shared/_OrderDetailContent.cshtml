@model OrderDetailViewModel
@{
    var order = Model.Order;
    var listUrl = Model.IsAdmin ? "/admin/don-hang" : "/don-hang";
    var cancelActionUrl = Model.IsAdmin ? $"/admin/don-hang/{order.Id}/huy" : $"/don-hang/{order.Id}/huy";
    var requiresCancelReason = Model.IsAdmin || User.IsInRole(RoleNames.Admin);
    var isCustomerOnly = User.Identity?.IsAuthenticated == true
        && User.IsInRole(RoleNames.Customer)
        && !User.IsInRole(RoleNames.Admin);
    var showReviewLinks = !Model.IsAdmin && isCustomerOnly && order.Status == OrderStatus.DELIVERED;

    var attemptedReason = "";
    if (ViewData.ModelState.TryGetValue("Reason", out var reasonState) && reasonState.AttemptedValue is not null)
    {
        attemptedReason = reasonState.AttemptedValue;
    }

    var codChecked = ViewData.ModelState.TryGetValue("ConfirmCodCollected", out var codState)
        && string.Equals(codState.AttemptedValue, "true", StringComparison.OrdinalIgnoreCase);

    var cancelConfirmMessage = ViewText.T(
        $"Bạn có chắc chắn muốn hủy đơn hàng {order.OrderCode}? Thao tác này không thể hoàn tác.",
        $"Are you sure you want to cancel order {order.OrderCode}? This action cannot be undone.");
}

@await Html.PartialAsync("_FormErrorBanner", ViewText.T("Không thể cập nhật đơn hàng. Vui lòng kiểm tra thông báo bên dưới:", "Could not update order. Please review the details below:"))

<section class="card bs-surface-card mb-4" aria-label="@ViewText.T("Thông tin chung đơn hàng", "Order overview")">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 pb-3 border-bottom mb-4">
            <div>
                <h1 class="h4 bs-serif-heading mb-2 d-flex flex-wrap align-items-center gap-2">
                    <code>@order.OrderCode</code>
                    @await Html.PartialAsync("_OrderStatusBadge", order.Status)
                    @await Html.PartialAsync("_PaymentStatusBadge", order.PaymentStatus)
                </h1>
                <div class="small text-secondary d-flex flex-wrap gap-3 bs-tabular">
                    <span>
                        @ViewText.T("Khách hàng:", "Account:") <strong class="text-dark">@order.UserName</strong>
                    </span>
                    <span>
                        @ViewText.T("Ngày đặt:", "Created:") <strong class="text-dark">@ViewText.FormatVietnamTime(order.CreatedAt)</strong>
                    </span>
                    @if (order.DeliveredAt.HasValue)
                    {
                        <span>
                            @ViewText.T("Ngày giao:", "Delivered:") <strong class="text-success">@ViewText.FormatVietnamTime(order.DeliveredAt.Value)</strong>
                        </span>
                    }
                    @if (order.CancelledAt.HasValue)
                    {
                        <span>
                            @ViewText.T("Ngày hủy:", "Cancelled:") <strong class="text-danger">@ViewText.FormatVietnamTime(order.CancelledAt.Value)</strong>
                        </span>
                    }
                </div>
            </div>

            <a href="@listUrl" class="btn btn-sm btn-outline-secondary">
                &larr; @(Model.IsAdmin
                    ? ViewText.T("Danh sách đơn", "Back to Orders")
                    : ViewText.T("Đơn hàng của tôi", "Back to My Orders"))
            </a>
        </div>

        <div class="row g-4">
            <div class="col-12 col-md-7">
                <h2 class="h6 fw-bold mb-3">
                    @ViewText.T("Thông tin nhận hàng", "Delivery Information")
                </h2>
                <dl class="row small mb-0">
                    <dt class="col-sm-4 text-secondary mb-2">@ViewText.T("Người nhận", "Recipient")</dt>
                    <dd class="col-sm-8 fw-semibold mb-2">@order.RecipientName</dd>

                    <dt class="col-sm-4 text-secondary mb-2">@ViewText.T("Số điện thoại", "Phone")</dt>
                    <dd class="col-sm-8 mb-2 bs-tabular">@order.Phone</dd>

                    <dt class="col-sm-4 text-secondary mb-2">@ViewText.T("Địa chỉ giao hàng", "Shipping Address")</dt>
                    <dd class="col-sm-8 mb-2 bs-preline bs-wrap-anywhere">@order.ShippingAddress</dd>

                    <dt class="col-sm-4 text-secondary mb-0">@ViewText.T("Ghi chú", "Order Note")</dt>
                    <dd class="col-sm-8 mb-0 bs-preline bs-wrap-anywhere">
                        @(string.IsNullOrWhiteSpace(order.Note)
                            ? ViewText.T("Không có ghi chú", "None")
                            : order.Note)
                    </dd>
                </dl>
            </div>

            <div class="col-12 col-md-5">
                <div class="bg-light border rounded-2 p-3 h-100">
                    <h2 class="h6 fw-bold mb-3">
                        @ViewText.T("Thanh toán & Tổng tiền", "Payment Summary")
                    </h2>
                    <div class="d-flex justify-content-between small mb-2">
                        <span class="text-secondary">@ViewText.T("Phương thức:", "Method:")</span>
                        <span class="fw-semibold">@order.PaymentMethod (@ViewText.T("Thanh toán khi nhận hàng", "Cash on Delivery"))</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-2">
                        <span class="text-secondary">@ViewText.T("Trạng thái:", "Status:")</span>
                        <span>@await Html.PartialAsync("_PaymentStatusBadge", order.PaymentStatus)</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between small mb-1 bs-tabular">
                        <span class="text-secondary">@ViewText.T("Tạm tính:", "Subtotal:")</span>
                        <span>@ViewText.FormatVnd(order.Subtotal)</span>
                    </div>
                    <div class="d-flex justify-content-between small mb-2 bs-tabular">
                        <span class="text-secondary">@ViewText.T("Phí giao hàng:", "Shipping Fee:")</span>
                        <span>@ViewText.FormatVnd(order.ShippingFee)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline border-top pt-2 bs-tabular">
                        <span class="fw-bold">@ViewText.T("Tổng cộng:", "Total:")</span>
                        <span class="fs-5 fw-bold bs-price-current">@ViewText.FormatVnd(order.TotalAmount)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="card bs-surface-card mb-4" aria-labelledby="order-items-heading">
    <div class="card-body p-0">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-3 border-bottom">
            <h2 id="order-items-heading" class="h6 fw-bold mb-0">
                @ViewText.T("Sản phẩm trong đơn", "Ordered Items")
            </h2>
            <span class="badge bs-badge-category bs-tabular">
                @order.Items.Count @ViewText.T("đầu sách", "titles")
            </span>
        </div>

        <div class="bs-admin-table-wrap">
            <table class="table bs-admin-table mb-0">
                <thead>
                    <tr>
                        <th>@ViewText.T("Tên sách", "Book Title")</th>
                        <th>SKU</th>
                        <th class="text-end">@ViewText.T("Đơn giá", "Unit Price")</th>
                        <th class="text-center">@ViewText.T("Số lượng", "Quantity")</th>
                        <th class="text-end">@ViewText.T("Thành tiền", "Line Total")</th>
                        @if (showReviewLinks)
                        {
                            <th class="text-end">@ViewText.T("Đánh giá", "Review")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in order.Items)
                    {
                        <tr>
                            <td class="fw-semibold bs-wrap-anywhere">
                                <a href="/sach/@line.BookId" class="text-decoration-none">@line.BookTitle</a>
                            </td>
                            <td class="text-nowrap"><code>@line.SKU</code></td>
                            <td class="text-end text-nowrap bs-tabular">@ViewText.FormatVnd(line.UnitPrice)</td>
                            <td class="text-center bs-tabular">@line.Quantity</td>
                            <td class="text-end fw-semibold text-nowrap bs-price-current bs-tabular">@ViewText.FormatVnd(line.LineTotal)</td>
                            @if (showReviewLinks)
                            {
                                <td class="text-end text-nowrap">
                                    <a href="/sach/@line.BookId/danh-gia" class="btn btn-sm btn-outline-secondary">
                                        @ViewText.T("Viết / sửa đánh giá", "Write / Edit Review")
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@if (Model.IsAdmin && order.NextStatus.HasValue)
{
    var nextStatus = order.NextStatus.Value;
    var nextLabelVi = nextStatus switch
    {
        OrderStatus.CONFIRMED => "Đã xác nhận",
        OrderStatus.SHIPPING => "Đang giao hàng",
        OrderStatus.DELIVERED => "Đã giao hàng",
        _ => nextStatus.ToString()
    };
    var nextLabelEn = nextStatus switch
    {
        OrderStatus.CONFIRMED => "Confirmed",
        OrderStatus.SHIPPING => "Shipping",
        OrderStatus.DELIVERED => "Delivered",
        _ => nextStatus.ToString()
    };
    var transitionConfirmMsg = ViewText.T(
        $"Xác nhận chuyển trạng thái đơn {order.OrderCode} sang “{nextLabelVi}”?",
        $"Confirm transitioning order {order.OrderCode} to “{nextLabelEn}”?");

    <section class="card bs-surface-card mb-4" aria-labelledby="admin-transition-heading">
        <div class="card-body p-4">
            <h2 id="admin-transition-heading" class="h6 fw-bold mb-2">
                @ViewText.T("Cập nhật trạng thái đơn hàng", "Update Order Status")
            </h2>
            <p class="small text-secondary mb-3">
                @ViewText.T("Bước chuyển tiếp theo:", "Next workflow step:")
                @await Html.PartialAsync("_OrderStatusBadge", order.Status)
                <span class="mx-1">&rarr;</span>
                @await Html.PartialAsync("_OrderStatusBadge", nextStatus)
            </p>

            <form method="post"
                  action="/admin/don-hang/@order.Id/trang-thai"
                  asp-antiforgery="true"
                  data-confirm="@transitionConfirmMsg"
                  data-prevent-double-submit="true"
                  novalidate>
                <input type="hidden" name="Status" value="@nextStatus" />

                @if (nextStatus == OrderStatus.DELIVERED)
                {
                    <div class="form-check p-3 ps-5 rounded-2 border bg-light mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="ConfirmCodCollected"
                               name="ConfirmCodCollected"
                               value="true"
                               checked="@(codChecked ? "checked" : null)"
                               required />
                        <label class="form-check-label fw-semibold" for="ConfirmCodCollected">
                            @ViewText.T(
                                $"Tôi xác nhận đơn hàng đã giao thành công tới người nhận và đã thu đủ tiền mặt COD ({ViewText.FormatVnd(order.TotalAmount)}).",
                                $"I confirm the order has been delivered and the full COD amount ({ViewText.FormatVnd(order.TotalAmount)}) has been collected.")
                        </label>
                        <input type="hidden" name="ConfirmCodCollected" value="false" />
                        @if (ViewData.ModelState.TryGetValue("ConfirmCodCollected", out var codErr) && codErr.Errors.Count > 0)
                        {
                            <div class="text-danger small mt-1">@codErr.Errors[0].ErrorMessage</div>
                        }
                    </div>
                }

                <button type="submit" class="btn bs-btn-primary px-4">
                    @ViewText.T($"Chuyển sang: {nextLabelVi}", $"Mark as: {nextLabelEn}")
                </button>
            </form>
        </div>
    </section>
}

@if (order.CanCancel)
{
    <section class="card bs-surface-card border-danger-subtle mb-4" aria-labelledby="order-cancel-heading">
        <div class="card-body p-4">
            <h2 id="order-cancel-heading" class="h6 fw-bold text-danger mb-2">
                @ViewText.T("Hủy đơn hàng", "Cancel Order")
            </h2>
            <p class="small text-secondary mb-3">
                @ViewText.T(
                    "Đơn hàng đang ở trạng thái cho phép hủy (Chờ xác nhận / Đã xác nhận). Khi hủy, số lượng sách giữ chỗ sẽ được hoàn trả lại kho.",
                    "This order can still be cancelled (Pending / Confirmed). Cancelling releases reserved stock back to available inventory.")
            </p>

            <form method="post"
                  action="@cancelActionUrl"
                  asp-antiforgery="true"
                  data-confirm="@cancelConfirmMessage"
                  data-prevent-double-submit="true"
                  novalidate>
                <div class="mb-3">
                    <label for="CancelReason" class="form-label fw-semibold">
                        @if (requiresCancelReason)
                        {
                            @ViewText.T("Lý do hủy đơn (bắt buộc)", "Cancellation Reason (required)") <span class="text-danger">*</span>
                        }
                        else
                        {
                            @ViewText.T("Lý do hủy đơn (tùy chọn)", "Cancellation Reason (optional)")
                        }
                    </label>
                    <textarea id="CancelReason"
                              name="Reason"
                              class="form-control"
                              rows="3"
                              maxlength="500"
                              required="@(requiresCancelReason ? "required" : null)"
                              placeholder="@(requiresCancelReason
                                  ? ViewText.T("Nhập lý do hủy đơn rõ ràng để lưu lịch sử...", "Provide a clear cancellation reason for audit history...")
                                  : ViewText.T("Ghi chú lý do hủy nếu cần (tối đa 500 ký tự)...", "Optional note explaining why you are cancelling (up to 500 characters)..."))">@attemptedReason</textarea>
                    <div class="form-text small">
                        @ViewText.T("Tối đa 500 ký tự.", "Up to 500 characters.")
                    </div>
                    @if (ViewData.ModelState.TryGetValue("Reason", out var reasonErr) && reasonErr.Errors.Count > 0)
                    {
                        <div class="text-danger small mt-1">@reasonErr.Errors[0].ErrorMessage</div>
                    }
                </div>

                <button type="submit" class="btn btn-outline-danger">
                    @ViewText.T("Xác nhận hủy đơn hàng", "Confirm Order Cancellation")
                </button>
            </form>
        </div>
    </section>
}

<section class="card bs-surface-card" aria-labelledby="order-timeline-heading">
    <div class="card-body p-4">
        <h2 id="order-timeline-heading" class="h6 fw-bold mb-3">
            @ViewText.T("Lịch sử trạng thái đơn hàng", "Order Timeline")
        </h2>

        @if (order.Events.Count == 0)
        {
            <p class="text-secondary small mb-0">
                @ViewText.T("Chưa có sự kiện lịch sử nào được ghi nhận.", "No timeline events recorded yet.")
            </p>
        }
        else
        {
            <ol class="bs-timeline">
                @foreach (var ev in order.Events)
                {
                    <li class="bs-timeline-item">
                        <span class="bs-timeline-dot" aria-hidden="true"></span>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                @if (ev.FromStatus.HasValue)
                                {
                                    @await Html.PartialAsync("_OrderStatusBadge", ev.FromStatus.Value)
                                    <span class="text-secondary small mx-1">&rarr;</span>
                                }
                                @await Html.PartialAsync("_OrderStatusBadge", ev.ToStatus)
                            </div>
                            <time class="small text-secondary bs-tabular" datetime="@ev.CreatedAt.ToString("O", CultureInfo.InvariantCulture)">
                                @ViewText.FormatVietnamTime(ev.CreatedAt)
                            </time>
                        </div>
                        <div class="small text-secondary">
                            @ViewText.T("Thực hiện bởi:", "Actor:") <strong class="text-dark">@ev.ActorUserName</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ev.Note))
                        {
                            <div class="small mt-1 p-2 rounded bg-light border bs-preline bs-wrap-anywhere">@ev.Note</div>
                        }
                    </li>
                }
            </ol>
        }
    </div>
</section>

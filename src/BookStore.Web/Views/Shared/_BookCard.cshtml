@model BookCardDto
@{
    var detailUrl = $"/sach/{Model.Id}";
    var hasDiscount = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value < Model.Price;
    var inStock = Model.AvailableQuantity > 0;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    if (string.IsNullOrWhiteSpace(currentReturnUrl) || !Url.IsLocalUrl(currentReturnUrl))
    {
        currentReturnUrl = "/";
    }
    var loginToAddUrl = $"/tai-khoan/dang-nhap?ReturnUrl={Uri.EscapeDataString(currentReturnUrl)}";
    var qtyLabel = ViewText.T($"Số lượng cho {Model.Title}", $"Quantity for {Model.Title}");
}
<article class="bs-book-card">
    <a href="@detailUrl" class="bs-book-cover-link" aria-label="@Model.Title">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
        {
            <img src="@Model.CoverImage"
                 alt="@Model.Title"
                 class="bs-book-cover-img"
                 loading="lazy" />
        }
        else
        {
            <div class="bs-book-cover-placeholder">
                <div class="bs-book-cover-placeholder-inner">
                    <div class="d-flex justify-content-between align-items-start gap-1">
                        <span class="bs-book-cover-category">@Model.CategoryName</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#78716C" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="flex-shrink-0">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                        </svg>
                    </div>
                    <strong class="bs-book-cover-title">@Model.Title</strong>
                    <div>
                        <span class="bs-book-cover-author">@Model.Author</span>
                    </div>
                </div>
            </div>
        }
    </a>

    <div class="bs-book-card-body">
        <div class="d-flex justify-content-between align-items-center gap-1 mb-1">
            <span class="small text-secondary text-truncate" title="@Model.CategoryName">@Model.CategoryName</span>
            @if (inStock)
            {
                <span class="badge bs-badge-instock bs-tabular flex-shrink-0">
                    @ViewText.T($"Còn {Model.AvailableQuantity}", $"{Model.AvailableQuantity} left")
                </span>
            }
            else
            {
                <span class="badge bs-badge-outstock flex-shrink-0">
                    @ViewText.T("Hết hàng", "Out of stock")
                </span>
            }
        </div>

        <h3 class="bs-book-title">
            <a href="@detailUrl">@Model.Title</a>
        </h3>

        <p class="bs-book-author" title="@Model.Author">@Model.Author</p>

        <div class="mt-auto">
            <div class="d-flex align-items-baseline justify-content-between gap-1 flex-wrap">
                <div class="d-flex align-items-baseline gap-2 flex-wrap">
                    <span class="bs-price-current @(hasDiscount ? "bs-price-sale" : "")">
                        @ViewText.FormatVnd(Model.SellingPrice)
                    </span>
                    @if (hasDiscount)
                    {
                        <del class="bs-price-original">@ViewText.FormatVnd(Model.Price)</del>
                    }
                </div>
                <span class="text-muted" style="font-size: 0.7rem;" title="SKU">@Model.SKU</span>
            </div>

            <div class="bs-card-cart-actions" data-book-id="@Model.Id">
                @if (!inStock)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-book-id="@Model.Id" disabled>
                        @ViewText.T("Hết hàng", "Out of stock")
                    </button>
                }
                else if (isAuthenticated)
                {
                    <form method="post"
                          action="/api/cart/items"
                          asp-antiforgery="true"
                          data-cart-add-form="true"
                          data-book-id="@Model.Id"
                          novalidate>
                        <div class="d-flex align-items-center gap-1">
                            <div class="bs-qty-stepper flex-shrink-0">
                                <button type="button"
                                        class="btn btn-sm"
                                        data-qty-step="-1"
                                        aria-label="@ViewText.T("Giảm", "Decrease")">&minus;</button>
                                <label for="card-qty-@Model.Id" class="visually-hidden">@qtyLabel</label>
                                <input id="card-qty-@Model.Id"
                                       type="number"
                                       name="quantity"
                                       value="1"
                                       min="1"
                                       max="@Model.AvailableQuantity"
                                       step="1"
                                       inputmode="numeric"
                                       class="form-control form-control-sm bs-qty-input" />
                                <button type="button"
                                        class="btn btn-sm"
                                        data-qty-step="1"
                                        aria-label="@ViewText.T("Tăng", "Increase")">+</button>
                            </div>
                            <button type="submit"
                                    class="btn btn-sm bs-btn-primary flex-grow-1 text-nowrap px-2"
                                    data-book-id="@Model.Id">
                                @ViewText.T("Thêm giỏ", "Add")
                            </button>
                        </div>
                        <div data-cart-feedback="true" class="d-none"></div>
                    </form>
                }
                else
                {
                    <a href="@loginToAddUrl"
                       class="btn btn-sm btn-outline-secondary w-100"
                       data-book-id="@Model.Id">
                        @ViewText.T("Thêm vào giỏ", "Add to Cart")
                    </a>
                }
            </div>
        </div>
    </div>
</article>

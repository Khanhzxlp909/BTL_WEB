@model BookCardDto
@{
    var detailUrl = $"/sach/{Model.Id}";
    var hasDiscount = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value < Model.Price;
    var inStock = Model.AvailableQuantity > 0;
}
<article class="card h-100 bs-book-card">
    <a href="@detailUrl" class="bs-book-cover-link text-decoration-none" aria-label="@Model.Title">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImage))
        {
            <div class="bs-book-cover-wrap">
                <img src="@Model.CoverImage"
                     alt="@Model.Title"
                     class="bs-book-cover-img"
                     loading="lazy" />
            </div>
        }
        else
        {
            <div class="bs-book-cover-placeholder">
                <span class="bs-book-cover-category">@Model.CategoryName</span>
                <strong class="bs-book-cover-title">@Model.Title</strong>
                <span class="bs-book-cover-author">@Model.Author</span>
                <span class="bs-book-cover-sku">SKU: @Model.SKU</span>
            </div>
        }
    </a>

    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <span class="badge bs-badge-category text-truncate" title="@Model.CategoryName">@Model.CategoryName</span>
            @if (inStock)
            {
                <span class="badge bs-badge-instock">
                    @ViewText.T($"Còn {Model.AvailableQuantity}", $"{Model.AvailableQuantity} in stock")
                </span>
            }
            else
            {
                <span class="badge bs-badge-outstock">
                    @ViewText.T("Hết hàng", "Out of stock")
                </span>
            }
        </div>

        <h3 class="h6 card-title bs-book-title mb-1">
            <a href="@detailUrl" class="stretched-link text-decoration-none">@Model.Title</a>
        </h3>

        <p class="small text-secondary mb-1 text-truncate" title="@Model.Author">
            @Model.Author
        </p>
        <p class="bs-book-meta small text-muted mb-3">
            SKU: <code>@Model.SKU</code>
        </p>

        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-baseline gap-2">
            <div>
                <span class="bs-price-current">@ViewText.FormatVnd(Model.SellingPrice)</span>
                @if (hasDiscount)
                {
                    <del class="bs-price-original ms-1">@ViewText.FormatVnd(Model.Price)</del>
                }
            </div>
            <span class="small fw-medium bs-card-cta">
                @ViewText.T("Chi tiết", "Details") &rarr;
            </span>
        </div>
    </div>
</article>

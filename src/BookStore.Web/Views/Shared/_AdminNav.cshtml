@{
    var currentPath = Context.Request.Path.Value ?? "/admin";
    var isOverview = string.Equals(currentPath, "/admin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentPath, "/admin/", StringComparison.OrdinalIgnoreCase);
    var isBooks = currentPath.StartsWith("/admin/sach", StringComparison.OrdinalIgnoreCase);
    var isCategories = currentPath.StartsWith("/admin/the-loai", StringComparison.OrdinalIgnoreCase);
    var isThreshold = currentPath.StartsWith("/admin/kho/nguong", StringComparison.OrdinalIgnoreCase);
    var isInventory = currentPath.StartsWith("/admin/kho", StringComparison.OrdinalIgnoreCase) && !isThreshold;

    var upcomingModules = new (string Vi, string En)[]
    {
        ("Đơn hàng", "Orders"),
        ("Đánh giá", "Reviews"),
        ("Khách hàng", "Customers"),
        ("Báo cáo", "Revenue Reports")
    };
}
<div class="card bs-surface-card h-100">
    <div class="card-body p-3 p-lg-4">
        <h2 class="h6 text-uppercase fw-bold text-secondary mb-3">
            @ViewText.T("Menu quản trị", "Admin Menu")
        </h2>

        <nav aria-label="@ViewText.T("Menu quản trị", "Admin navigation")" class="d-grid gap-1 mb-3">
            <a href="/admin"
               class="btn btn-sm text-start @(isOverview ? "bs-btn-primary" : "btn-outline-secondary")"
               aria-current="@(isOverview ? "page" : null)">
                @ViewText.T("Tổng quan", "Overview")
            </a>
            <a href="/admin/sach"
               class="btn btn-sm text-start @(isBooks ? "bs-btn-primary" : "btn-outline-secondary")"
               aria-current="@(isBooks ? "page" : null)">
                @ViewText.T("Sách", "Books")
            </a>
            <a href="/admin/the-loai"
               class="btn btn-sm text-start @(isCategories ? "bs-btn-primary" : "btn-outline-secondary")"
               aria-current="@(isCategories ? "page" : null)">
                @ViewText.T("Thể loại", "Categories")
            </a>
            <a href="/admin/kho"
               class="btn btn-sm text-start @(isInventory ? "bs-btn-primary" : "btn-outline-secondary")"
               aria-current="@(isInventory ? "page" : null)">
                @ViewText.T("Kho", "Inventory")
            </a>
            <a href="/admin/kho/nguong"
               class="btn btn-sm text-start @(isThreshold ? "bs-btn-primary" : "btn-outline-secondary")"
               aria-current="@(isThreshold ? "page" : null)">
                @ViewText.T("Ngưỡng tồn thấp", "Low-Stock Threshold")
            </a>
            <hr class="my-2" />
            <a href="/" class="btn btn-sm btn-outline-secondary text-start">
                @ViewText.T("Chuyển sang cửa hàng", "Switch to Storefront")
            </a>
            <a href="/sach" class="btn btn-sm btn-outline-secondary text-start">
                @ViewText.T("Xem danh mục công khai", "View Public Catalog")
            </a>
        </nav>

        <div class="border-top pt-3">
            <div class="small fw-semibold text-secondary mb-2">
                @ViewText.T("Phân hệ giai đoạn tiếp theo", "Upcoming Modules")
            </div>
            <ul class="list-unstyled small mb-0 d-grid gap-2">
                @foreach (var item in upcomingModules)
                {
                    <li class="d-flex justify-content-between align-items-center text-muted py-1 border-bottom">
                        <span>@ViewText.T(item.Vi, item.En)</span>
                        <span class="badge text-bg-light border">
                            @ViewText.T("Đang phát triển", "Planned")
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

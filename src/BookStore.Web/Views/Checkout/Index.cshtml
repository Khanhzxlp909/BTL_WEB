@model CheckoutViewModel
@{
    ViewData["Title"] = ViewText.T("Đặt hàng (COD)", "Checkout (COD)");
    var cart = Model.Cart;
    var hasPriceChanged = cart.Items.Any(x => x.PriceChanged);
    var warningItems = cart.Items.Where(x => !string.IsNullOrWhiteSpace(x.Warning)).ToList();
    var needsReconfirmBanner = Context.Response.StatusCode >= 400
        && ViewData.ModelState.IsValid
        && string.IsNullOrWhiteSpace(ViewData["ErrorCode"] as string);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">@ViewText.T("Trang chủ", "Home")</a></li>
        <li class="breadcrumb-item"><a href="/gio-hang" class="text-decoration-none">@ViewText.T("Giỏ hàng", "Cart")</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewText.T("Đặt hàng", "Checkout")</li>
    </ol>
</nav>

<div id="bs-checkout-page" data-cart-item-count="@cart.ItemCount">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h3 bs-serif-heading mb-1">
                @ViewText.T("Xác nhận đặt hàng", "Confirm Your Order")
            </h1>
            <p class="text-secondary small mb-0">
                @ViewText.T(
                    "Kiểm tra thông tin người nhận, xác nhận báo giá hiện tại và đặt hàng thanh toán khi nhận hàng (COD).",
                    "Verify recipient details, confirm the current quotation, and place your Cash on Delivery (COD) order.")
            </p>
        </div>
        <a href="/gio-hang" class="btn btn-sm btn-outline-secondary">
            &larr; @ViewText.T("Quay lại giỏ hàng", "Back to Cart")
        </a>
    </div>

    @await Html.PartialAsync("_FormErrorBanner", ViewText.T("Chưa thể tạo đơn hàng. Vui lòng kiểm tra lại báo giá hoặc thông tin nhận hàng:", "Unable to place order. Please review the updated quotation or recipient details:"))

    @if (needsReconfirmBanner)
    {
        <div class="alert alert-danger small mb-4" role="alert">
            <strong>@ViewText.T("Cần xác nhận báo giá & COD:", "Quotation & COD confirmation required:")</strong>
            @ViewText.T(
                "Báo giá vừa được làm mới hoặc bạn chưa tích ô xác nhận. Hãy kiểm tra lại tổng tiền và tích chọn ô xác nhận báo giá COD trước khi đặt hàng.",
                "The quotation was refreshed or the confirmation box was not checked. Review the total amount and check the COD confirmation box before placing your order.")
        </div>
    }

    @if (cart.Items.Count == 0)
    {
        <section class="card bs-surface-card">
            <div class="card-body p-4 p-lg-5 text-center">
                <h2 class="h5 bs-serif-heading mb-2">
                    @ViewText.T("Giỏ hàng trống — không có sách để đặt", "Your cart is empty — no items to order")
                </h2>
                <p class="text-secondary small mb-3">
                    @ViewText.T("Hãy thêm sách vào giỏ hàng trước khi tiến hành đặt hàng.", "Add books to your cart before proceeding to checkout.")
                </p>
                <a href="/sach" class="btn bs-btn-primary">
                    @ViewText.T("Xem danh mục sách", "Browse Catalog")
                </a>
            </div>
        </section>
    }
    else
    {
        <form method="post"
              action="/dat-hang"
              asp-antiforgery="true"
              data-prevent-double-submit="true"
              novalidate>
            @* Always emit the server's latest signed QuoteToken rather than stale ModelState *@
            <input type="hidden" id="Input_QuoteToken" name="Input.QuoteToken" value="@Model.Input.QuoteToken" />
            <span asp-validation-for="Input.QuoteToken" class="text-danger small d-block mb-2"></span>

            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <section class="card bs-surface-card mb-4" aria-labelledby="checkout-recipient-heading">
                        <div class="card-body p-4">
                            <h2 id="checkout-recipient-heading" class="h5 bs-serif-heading mb-3">
                                @ViewText.T("Thông tin người nhận", "Recipient Information")
                            </h2>

                            <div class="mb-3">
                                <label asp-for="Input.RecipientName" class="form-label fw-semibold">
                                    @ViewText.T("Tên người nhận", "Recipient Name") <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.RecipientName"
                                       class="form-control"
                                       maxlength="100"
                                       autocomplete="name"
                                       required />
                                <span asp-validation-for="Input.RecipientName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Phone" class="form-label fw-semibold">
                                    @ViewText.T("Số điện thoại liên hệ", "Phone Number") <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Phone"
                                       type="tel"
                                       class="form-control"
                                       maxlength="20"
                                       autocomplete="tel"
                                       placeholder="@ViewText.T("VD: 0912345678", "e.g. +84 912 345 678")"
                                       required />
                                <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.ShippingAddress" class="form-label fw-semibold">
                                    @ViewText.T("Địa chỉ giao hàng", "Shipping Address") <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Input.ShippingAddress"
                                          class="form-control"
                                          rows="3"
                                          maxlength="255"
                                          autocomplete="street-address"
                                          placeholder="@ViewText.T("Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố...", "Street address, ward, district, city...")"
                                          required></textarea>
                                <span asp-validation-for="Input.ShippingAddress" class="text-danger small"></span>
                            </div>

                            <div class="mb-0">
                                <label asp-for="Input.Note" class="form-label fw-semibold">
                                    @ViewText.T("Ghi chú giao hàng (tùy chọn)", "Delivery Note (optional)")
                                </label>
                                <textarea asp-for="Input.Note"
                                          class="form-control"
                                          rows="2"
                                          maxlength="500"
                                          placeholder="@ViewText.T("Khung giờ nhận thuận tiện, hướng dẫn giao hàng...", "Preferred delivery hours or instructions...")"></textarea>
                                <div class="form-text small">
                                    @ViewText.T("Tối đa 500 ký tự.", "Up to 500 characters.")
                                </div>
                                <span asp-validation-for="Input.Note" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>

                    <section class="card bs-surface-card" aria-labelledby="checkout-payment-heading">
                        <div class="card-body p-4">
                            <h2 id="checkout-payment-heading" class="h5 bs-serif-heading mb-3">
                                @ViewText.T("Hình thức thanh toán", "Payment Method")
                            </h2>

                            <div class="form-check p-3 ps-5 rounded-3 border bg-light-subtle mb-3">
                                <input class="form-check-input"
                                       type="radio"
                                       id="payment-method-cod"
                                       name="PaymentMethodDisplay"
                                       value="COD"
                                       checked
                                       disabled />
                                <label class="form-check-label fw-semibold text-dark opacity-100" for="payment-method-cod">
                                    @ViewText.T(
                                        "Thanh toán khi nhận hàng (COD) — Phí giao hàng: 0 đ",
                                        "Cash on Delivery (COD) — Shipping fee: 0 đ")
                                </label>
                                <div class="small text-secondary mt-1">
                                    @ViewText.T(
                                        "Phương thức duy nhất hiện hỗ trợ. Bạn thanh toán trực tiếp bằng tiền mặt đúng số tiền trên đơn khi nhận sách.",
                                        "Only supported payment method. Pay the exact order total upon receiving your books.")
                                </div>
                            </div>

                            <div class="form-check p-3 ps-5 rounded-3 border border-success-subtle bg-white">
                                @* Bind checked directly to Model.Input.ConfirmQuote so quote resets always clear the checkbox *@
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="Input_ConfirmQuote"
                                       name="Input.ConfirmQuote"
                                       value="true"
                                       checked="@(Model.Input.ConfirmQuote ? "checked" : null)"
                                       required />
                                <label class="form-check-label fw-semibold" for="Input_ConfirmQuote">
                                    @ViewText.T(
                                        $"Tôi xác nhận đồng ý báo giá hiện tại ({ViewText.FormatVnd(cart.TotalAmount)}, phí giao hàng 0 đ) và đặt mua theo hình thức COD.",
                                        $"I confirm the current quotation ({ViewText.FormatVnd(cart.TotalAmount)}, 0 đ shipping) and agree to place this COD order.")
                                </label>
                                <input type="hidden" name="Input.ConfirmQuote" value="false" />
                                <span asp-validation-for="Input.ConfirmQuote" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-12 col-lg-5">
                    <section class="card bs-surface-card" aria-labelledby="checkout-summary-heading">
                        <div class="card-body p-4">
                            <h2 id="checkout-summary-heading" class="h5 bs-serif-heading mb-3">
                                @ViewText.T("Tóm tắt đơn hàng", "Order Summary")
                            </h2>

                            @if (hasPriceChanged || warningItems.Count > 0)
                            {
                                <div class="alert alert-warning small mb-3" role="status">
                                    <div class="fw-semibold mb-1">
                                        @ViewText.T(
                                            "Thông báo cập nhật báo giá / tồn kho:",
                                            "Updated quotation / stock notice:")
                                    </div>
                                    <ul class="mb-1 ps-3">
                                        @foreach (var w in warningItems)
                                        {
                                            <li><strong>@w.Title:</strong> @w.Warning</li>
                                        }
                                    </ul>
                                    <div>
                                        @ViewText.T(
                                            "Báo giá đã được làm mới. Hãy kiểm tra kỹ và tích lại ô xác nhận báo giá trước khi gửi.",
                                            "The quotation has been refreshed. Review the updated totals and re-check the confirmation box before submitting.")
                                    </div>
                                </div>
                            }

                            <ul class="list-group list-group-flush mb-3 border-top border-bottom">
                                @foreach (var line in cart.Items)
                                {
                                    <li class="list-group-item px-0 py-2 bg-transparent">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="min-w-0">
                                                <div class="fw-semibold small bs-wrap-anywhere">@line.Title</div>
                                                <div class="small text-secondary">
                                                    <code>@line.SKU</code> &middot; @ViewText.FormatVnd(line.UnitPrice) &times; @line.Quantity
                                                </div>
                                                @if (!line.IsAvailable)
                                                {
                                                    <span class="badge bs-badge-outstock mt-1">
                                                        @ViewText.T("Không khả dụng", "Unavailable")
                                                    </span>
                                                }
                                            </div>
                                            <div class="fw-semibold small text-nowrap">
                                                @ViewText.FormatVnd(line.LineTotal)
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-secondary">@ViewText.T("Tạm tính:", "Subtotal:")</span>
                                <span>@ViewText.FormatVnd(cart.Subtotal)</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-secondary">@ViewText.T("Phí giao hàng:", "Shipping fee:")</span>
                                <span>@ViewText.FormatVnd(cart.ShippingFee)</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span class="text-secondary">@ViewText.T("Thanh toán:", "Payment:")</span>
                                <span class="fw-semibold">COD</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-baseline border-top pt-3 mb-3">
                                <span class="fw-bold">@ViewText.T("Tổng cộng:", "Total:")</span>
                                <span class="fs-4 fw-bold bs-price-current">@ViewText.FormatVnd(cart.TotalAmount)</span>
                            </div>

                            @if (!cart.CanCheckout)
                            {
                                <div class="alert alert-danger small py-2 px-3 mb-3">
                                    @ViewText.T(
                                        "Giỏ hàng hiện có mục không khả dụng hoặc vượt tồn kho. Hãy quay lại giỏ hàng để điều chỉnh trước khi đặt.",
                                        "One or more items in your cart are unavailable or exceed stock. Return to your cart to adjust quantities.")
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button type="submit"
                                        class="btn bs-btn-primary py-2"
                                        disabled="@(!cart.CanCheckout ? "disabled" : null)">
                                    @ViewText.T("Đặt hàng", "Place Order")
                                </button>
                                <a href="/gio-hang" class="btn btn-outline-secondary btn-sm">
                                    @ViewText.T("Chỉnh sửa giỏ hàng", "Edit Cart")
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </form>
    }
</div>

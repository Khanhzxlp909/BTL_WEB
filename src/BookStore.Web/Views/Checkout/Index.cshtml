@model CheckoutViewModel
@{
    ViewData["Title"] = ViewText.T("Đặt hàng", "Checkout");
    var cart = Model.Cart;
    var errorCode = ViewData["ErrorCode"] as string;
    var isQuoteChanged = string.Equals(errorCode, "CHECKOUT_QUOTE_CHANGED", StringComparison.OrdinalIgnoreCase);
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">@ViewText.T("Trang chủ", "Home")</a></li>
        <li class="breadcrumb-item"><a href="/gio-hang" class="text-decoration-none">@ViewText.T("Giỏ hàng", "Cart")</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewText.T("Đặt hàng", "Checkout")</li>
    </ol>
</nav>

<div id="bs-checkout-page" data-cart-item-count="@cart.ItemCount">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 bs-serif-heading fw-bold mb-0">
            @ViewText.T("Xác nhận đặt hàng", "Checkout & Order Confirmation")
        </h1>
        <a href="/gio-hang" class="btn btn-sm btn-outline-secondary">
            &larr; @ViewText.T("Quay lại giỏ hàng", "Back to Cart")
        </a>
    </div>

    @await Html.PartialAsync("_FormErrorBanner", ViewText.T("Chưa thể hoàn tất đặt hàng. Vui lòng kiểm tra thông báo bên dưới:", "Could not place your order. Please review the details below:"))

    @if (cart.Items.Count == 0)
    {
        <section class="bs-empty-state">
            <h2 class="h5 fw-bold mb-2">
                @ViewText.T("Giỏ hàng của bạn đang trống", "Your cart is empty")
            </h2>
            <p class="text-secondary small mb-3">
                @ViewText.T(
                    "Vui lòng thêm sách vào giỏ trước khi tiến hành đặt hàng.",
                    "Please add books to your cart before proceeding to checkout.")
            </p>
            <a href="/sach" class="btn bs-btn-primary px-4">
                @ViewText.T("Khám phá danh mục sách", "Browse Catalog")
            </a>
        </section>
    }
    else
    {
        <form method="post"
              action="/dat-hang"
              asp-antiforgery="true"
              data-prevent-double-submit="true">
            <input type="hidden" name="Input.QuoteToken" value="@Model.Input.QuoteToken" />

            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <section class="card bs-surface-card mb-4" aria-labelledby="checkout-recipient-heading">
                        <div class="card-body p-4">
                            <h2 id="checkout-recipient-heading" class="h6 fw-bold mb-3">
                                @ViewText.T("1. Thông tin người nhận", "1. Recipient Information")
                            </h2>

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="Input.RecipientName" class="form-label fw-semibold">
                                        @ViewText.T("Họ và tên người nhận", "Recipient Full Name") <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Input.RecipientName"
                                           class="form-control"
                                           maxlength="100"
                                           autocomplete="name"
                                           required />
                                    <span asp-validation-for="Input.RecipientName" class="text-danger small"></span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Input.Phone" class="form-label fw-semibold">
                                        @ViewText.T("Số điện thoại liên hệ", "Phone Number") <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Input.Phone"
                                           class="form-control bs-tabular"
                                           maxlength="20"
                                           autocomplete="tel"
                                           placeholder="0901234567"
                                           required />
                                    <span asp-validation-for="Input.Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Input.ShippingAddress" class="form-label fw-semibold">
                                        @ViewText.T("Địa chỉ giao hàng", "Shipping Address") <span class="text-danger">*</span>
                                    </label>
                                    <textarea asp-for="Input.ShippingAddress"
                                              class="form-control"
                                              rows="2"
                                              maxlength="255"
                                              placeholder="@ViewText.T("Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố...", "Street address, ward, district, city/province...")"
                                              required></textarea>
                                    <span asp-validation-for="Input.ShippingAddress" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Input.Note" class="form-label fw-semibold">
                                        @ViewText.T("Ghi chú giao hàng (tùy chọn)", "Delivery Note (optional)")
                                    </label>
                                    <textarea asp-for="Input.Note"
                                              class="form-control"
                                              rows="2"
                                              maxlength="500"
                                              placeholder="@ViewText.T("Hướng dẫn thời gian nhận hàng hoặc ghi chú cho bưu tá...", "Optional delivery instructions...")"></textarea>
                                    <span asp-validation-for="Input.Note" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="card bs-surface-card" aria-labelledby="checkout-payment-heading">
                        <div class="card-body p-4">
                            <h2 id="checkout-payment-heading" class="h6 fw-bold mb-3">
                                @ViewText.T("2. Phương thức thanh toán & Xác nhận báo giá", "2. Payment Method & Quotation Confirmation")
                            </h2>

                            <div class="p-3 rounded-2 border bg-light mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">
                                        @ViewText.T("Thanh toán khi nhận hàng (COD)", "Cash on Delivery (COD)")
                                    </span>
                                    <span class="badge bs-badge-instock">
                                        @ViewText.T("Miễn phí giao hàng (0 đ)", "Free shipping (0 đ)")
                                    </span>
                                </div>
                                <div class="small text-secondary mt-1">
                                    @ViewText.T(
                                        "Thanh toán tiền mặt trực tiếp cho nhân viên giao hàng khi nhận sách.",
                                        "Pay cash directly to the courier upon receiving your books.")
                                </div>
                            </div>

                            <div class="form-check p-3 ps-5 rounded-2 border @(isQuoteChanged ? "border-warning bg-warning-subtle" : "bg-light")">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="Input_ConfirmQuote"
                                       name="Input.ConfirmQuote"
                                       value="true"
                                       checked="@(Model.Input.ConfirmQuote ? "checked" : null)"
                                       required />
                                <label class="form-check-label fw-semibold" for="Input_ConfirmQuote">
                                    @ViewText.T(
                                        $"Tôi đã kiểm tra danh sách sách, đồng ý với báo giá tổng cộng {ViewText.FormatVnd(cart.TotalAmount)} và xác nhận đặt hàng thanh toán COD.",
                                        $"I have reviewed the order items, agree to the quotation total of {ViewText.FormatVnd(cart.TotalAmount)}, and confirm Cash on Delivery (COD).")
                                </label>
                                <input type="hidden" name="Input.ConfirmQuote" value="false" />
                                <span asp-validation-for="Input.ConfirmQuote" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="col-12 col-lg-5">
                    <section class="card bs-surface-card bs-cart-summary-card bs-cart-summary-sticky" aria-labelledby="checkout-quote-heading">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 id="checkout-quote-heading" class="h6 fw-bold mb-0">
                                    @ViewText.T("Đơn hàng của bạn", "Order Summary")
                                </h2>
                                <span class="badge bs-badge-category bs-tabular">
                                    @cart.ItemCount @ViewText.T("cuốn", "items")
                                </span>
                            </div>

                            @if (isQuoteChanged)
                            {
                                <div class="alert alert-warning small py-2 px-3 mb-3">
                                    @ViewText.T(
                                        "Báo giá đã được làm mới. Hãy kiểm tra kỹ và tích lại ô xác nhận báo giá trước khi đặt hàng.",
                                        "The quotation has been refreshed. Review the updated totals and re-check the confirmation box before submitting.")
                                </div>
                            }

                            <ul class="list-group list-group-flush mb-3 border-top border-bottom">
                                @foreach (var line in cart.Items)
                                {
                                    <li class="list-group-item px-0 py-2 bg-transparent">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="min-w-0">
                                                <div class="fw-semibold small bs-wrap-anywhere">@line.Title</div>
                                                <div class="small text-secondary bs-tabular">
                                                    <code>@line.SKU</code> &middot; @ViewText.FormatVnd(line.UnitPrice) &times; @line.Quantity
                                                </div>
                                                @if (!line.IsAvailable)
                                                {
                                                    <span class="badge bs-badge-outstock mt-1">
                                                        @ViewText.T("Không khả dụng", "Unavailable")
                                                    </span>
                                                }
                                            </div>
                                            <div class="fw-semibold small text-nowrap bs-tabular">
                                                @ViewText.FormatVnd(line.LineTotal)
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex justify-content-between small mb-2 bs-tabular">
                                <span class="text-secondary">@ViewText.T("Tạm tính:", "Subtotal:")</span>
                                <span>@ViewText.FormatVnd(cart.Subtotal)</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-2 bs-tabular">
                                <span class="text-secondary">@ViewText.T("Phí giao hàng:", "Shipping fee:")</span>
                                <span>@ViewText.FormatVnd(cart.ShippingFee)</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-3">
                                <span class="text-secondary">@ViewText.T("Thanh toán:", "Payment:")</span>
                                <span class="fw-semibold">COD</span>
                            </div>

                            <div class="d-flex justify-content-between align-items-baseline border-top pt-3 mb-3 bs-tabular">
                                <span class="fw-bold">@ViewText.T("Tổng cộng:", "Total:")</span>
                                <span class="fs-4 fw-bold bs-price-current">@ViewText.FormatVnd(cart.TotalAmount)</span>
                            </div>

                            @if (!cart.CanCheckout)
                            {
                                <div class="alert alert-danger small py-2 px-3 mb-3">
                                    @ViewText.T(
                                        "Giỏ hàng hiện có mục không khả dụng hoặc vượt tồn kho. Hãy quay lại giỏ hàng để điều chỉnh trước khi đặt.",
                                        "One or more items in your cart are unavailable or exceed stock. Return to your cart to adjust quantities.")
                                </div>
                            }

                            <div class="d-grid gap-2">
                                <button type="submit"
                                        class="btn bs-btn-primary py-2 fw-semibold"
                                        disabled="@(!cart.CanCheckout ? "disabled" : null)">
                                    @ViewText.T("Đặt hàng", "Place Order")
                                </button>
                                <a href="/gio-hang" class="btn btn-outline-secondary btn-sm">
                                    @ViewText.T("Chỉnh sửa giỏ hàng", "Edit Cart")
                                </a>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </form>
    }
</div>

@model ChangePasswordViewModel
@{
    ViewData["Title"] = ViewText.T("Đổi mật khẩu", "Change Password");
}

<section class="row justify-content-center py-2">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card bs-surface-card">
            <div class="card-body p-4 p-lg-5">
                <h1 class="h3 bs-serif-heading mb-1">
                    @ViewText.T("Đổi mật khẩu", "Change Password")
                </h1>
                <p class="text-secondary small mb-4">
                    @ViewText.T(
                        "Sau khi đổi mật khẩu thành công, phiên đăng nhập hiện tại sẽ kết thúc để bảo mật tài khoản.",
                        "After changing your password, your current session will be signed out for security.")
                </p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small" role="alert"></div>
                }

                <form method="post" action="/tai-khoan/doi-mat-khau" asp-antiforgery="true" novalidate>
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">
                            @ViewText.T("Mật khẩu hiện tại", "Current Password")
                        </label>
                        <input asp-for="CurrentPassword"
                               type="password"
                               value=""
                               class="form-control"
                               maxlength="64"
                               autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">
                            @ViewText.T("Mật khẩu mới", "New Password")
                        </label>
                        <input asp-for="NewPassword"
                               type="password"
                               value=""
                               class="form-control"
                               maxlength="64"
                               autocomplete="new-password"
                               placeholder="@ViewText.T("10-64 ký tự", "10-64 characters")" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                            @ViewText.T("Xác nhận mật khẩu mới", "Confirm New Password")
                        </label>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               value=""
                               class="form-control"
                               maxlength="64"
                               autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn bs-btn-primary px-4">
                            @ViewText.T("Cập nhật mật khẩu", "Update password")
                        </button>
                        <a href="/tai-khoan/ho-so" class="btn btn-outline-secondary">
                            @ViewText.T("Quay lại hồ sơ", "Back to profile")
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@model ProfileViewModel
@{
    ViewData["Title"] = ViewText.T("Hồ sơ cá nhân", "My Profile");
}

<section class="bs-auth-wrap">
    <div class="card bs-surface-card">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h1 class="h4 bs-serif-heading fw-bold mb-0">
                    @ViewText.T("Hồ sơ cá nhân", "My Profile")
                </h1>
                <a href="/tai-khoan/doi-mat-khau" class="btn btn-sm btn-outline-secondary">
                    @ViewText.T("Đổi mật khẩu", "Change Password")
                </a>
            </div>

            @await Html.PartialAsync("_FormErrorBanner", ViewText.T("Không thể lưu hồ sơ. Vui lòng kiểm tra các trường bên dưới:", "Unable to update profile. Please review the fields below:"))

            <form method="post" action="/tai-khoan/ho-so" asp-antiforgery="true" novalidate>
                <div class="mb-3">
                    <label for="profile-username" class="form-label fw-semibold">
                        @ViewText.T("Tên đăng nhập", "Username")
                    </label>
                    <input id="profile-username"
                           type="text"
                           value="@Model.UserName"
                           class="form-control bg-light"
                           readonly />
                </div>

                <div class="mb-3">
                    <label for="profile-email" class="form-label fw-semibold">Email</label>
                    <input id="profile-email"
                           type="email"
                           value="@Model.Email"
                           class="form-control bg-light"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">
                        @ViewText.T("Họ và tên", "Full Name")
                    </label>
                    <input asp-for="FullName"
                           class="form-control"
                           maxlength="100"
                           autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PhoneNumber" class="form-label fw-semibold">
                        @ViewText.T("Số điện thoại", "Phone Number")
                    </label>
                    <input asp-for="PhoneNumber"
                           class="form-control bs-tabular"
                           maxlength="20"
                           autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn bs-btn-primary py-2">
                        @ViewText.T("Lưu hồ sơ", "Save profile")
                    </button>
                    <a href="/don-hang" class="btn btn-outline-secondary btn-sm">
                        @ViewText.T("Xem đơn hàng của tôi", "View My Orders")
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

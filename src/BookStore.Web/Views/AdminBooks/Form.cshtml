@model BookFormViewModel
@{
    Layout = "_AdminLayout";
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit
        ? ViewText.T($"Chỉnh sửa sách #{Model.Id!.Value}", $"Edit Book #{Model.Id!.Value}")
        : ViewText.T("Thêm sách mới", "Add New Book");
    var formAction = isEdit ? $"/admin/sach/{Model.Id!.Value}/sua" : "/admin/sach/them";
    var hasCategories = Model.Categories.Count > 0;
}

@section PageActions {
    <a href="/admin/sach" class="btn btn-sm btn-outline-secondary">
        &larr; @ViewText.T("Danh sách sách", "Back to Books")
    </a>
}

@await Html.PartialAsync("_FormErrorBanner", ViewText.T("Không thể lưu thông tin sách. Vui lòng kiểm tra các trường bên dưới:", "Unable to save book. Please review the fields below:"))

@if (!hasCategories)
{
    <div class="alert alert-warning mb-4" role="alert">
        <div class="fw-semibold mb-1">
            @ViewText.T("Chưa có thể loại sách đang hoạt động", "No active book categories available")
        </div>
        <div class="small mb-2">
            @ViewText.T(
                "Hãy tạo ít nhất một thể loại trước khi thêm hoặc lưu thông tin sách.",
                "Please create at least one category before creating or saving a book.")
        </div>
        <a href="/admin/the-loai/them" class="btn btn-sm bs-btn-primary">
            + @ViewText.T("Thêm thể loại mới", "Add New Category")
        </a>
    </div>
}

<section class="card bs-surface-card">
    <div class="card-body p-4">
        <form method="post"
              action="@formAction"
              enctype="multipart/form-data"
              asp-antiforgery="true"
              data-prevent-double-submit="true"
              novalidate>
            <div class="row g-3">
                <div class="col-12 col-md-8">
                    <label asp-for="Title" class="form-label fw-semibold">
                        @ViewText.T("Tên sách", "Book Title") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control" maxlength="255" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="CategoryId" class="form-label fw-semibold">
                        @ViewText.T("Thể loại", "Category") <span class="text-danger">*</span>
                    </label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="0">@ViewText.T("-- Chọn thể loại --", "-- Select category --")</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Author" class="form-label fw-semibold">
                        @ViewText.T("Tác giả", "Author") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Author" class="form-control" maxlength="150" required />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="Publisher" class="form-label fw-semibold">
                        @ViewText.T("Nhà xuất bản", "Publisher")
                    </label>
                    <input asp-for="Publisher" class="form-control" maxlength="150" />
                    <span asp-validation-for="Publisher" class="text-danger small"></span>
                </div>

                <div class="col-12 col-sm-4">
                    <label asp-for="SKU" class="form-label fw-semibold">
                        SKU <span class="text-danger">*</span>
                    </label>
                    <input asp-for="SKU" class="form-control" maxlength="64" required />
                    <span asp-validation-for="SKU" class="text-danger small"></span>
                </div>

                <div class="col-12 col-sm-4">
                    <label asp-for="ISBN" class="form-label fw-semibold">ISBN</label>
                    <input asp-for="ISBN" class="form-control" maxlength="30" />
                    <span asp-validation-for="ISBN" class="text-danger small"></span>
                </div>

                <div class="col-12 col-sm-4">
                    <label asp-for="PublishedYear" class="form-label fw-semibold">
                        @ViewText.T("Năm xuất bản", "Published Year")
                    </label>
                    <input asp-for="PublishedYear"
                           type="number"
                           min="1"
                           max="@DateTime.UtcNow.AddHours(7).Year"
                           step="1"
                           inputmode="numeric"
                           class="form-control bs-tabular" />
                    <span asp-validation-for="PublishedYear" class="text-danger small"></span>
                </div>

                <div class="col-12 col-sm-6">
                    <label asp-for="Price" class="form-label fw-semibold">
                        @ViewText.T("Giá gốc (VND)", "Regular Price (VND)") <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Price"
                           type="number"
                           min="1"
                           step="1"
                           inputmode="numeric"
                           class="form-control bs-tabular"
                           required />
                    <div class="form-text small">
                        @ViewText.T("Nhập số nguyên đồng dương (ví dụ: 120000).", "Positive whole VND integer (e.g., 120000).")
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-12 col-sm-6">
                    <label asp-for="DiscountPrice" class="form-label fw-semibold">
                        @ViewText.T("Giá khuyến mãi (VND, tùy chọn)", "Discount Price (VND, optional)")
                    </label>
                    <input asp-for="DiscountPrice"
                           type="number"
                           min="1"
                           step="1"
                           inputmode="numeric"
                           class="form-control bs-tabular" />
                    <div class="form-text small">
                        @ViewText.T("Để trống nếu không giảm giá; nếu nhập phải không vượt giá gốc.", "Leave blank if not discounted; must not exceed regular price.")
                    </div>
                    <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-semibold">
                        @ViewText.T("Mô tả nội dung", "Description")
                    </label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="p-3 rounded-2 border bg-light">
                        <div class="row g-3 align-items-center">
                            <div class="col-12 col-md-8">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                                    <label asp-for="CoverFile" class="form-label fw-semibold mb-0">
                                        @ViewText.T("Ảnh bìa sách (tùy chọn)", "Cover Image File (optional)")
                                    </label>
                                    <span id="bs-cover-file-selected" class="badge bs-badge-category d-none"></span>
                                </div>
                                <input asp-for="CoverFile"
                                       type="file"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                       class="form-control" />
                                <div class="form-text small">
                                    @ViewText.T(
                                        "Chấp nhận tệp .jpg, .jpeg, .png hoặc .webp, tối đa 5 MB.",
                                        "Accepts .jpg, .jpeg, .png, or .webp files up to 5 MB.")
                                </div>
                                <span asp-validation-for="CoverFile" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4 text-md-end">
                                @if (!string.IsNullOrWhiteSpace(Model.ExistingCoverImage))
                                {
                                    <div class="small text-secondary mb-1">
                                        @ViewText.T("Ảnh bìa hiện tại:", "Current cover:")
                                    </div>
                                    <img src="@Model.ExistingCoverImage"
                                         alt="@Model.Title"
                                         class="bs-admin-cover-preview" />
                                }
                                else
                                {
                                    <div class="small text-secondary">
                                        @ViewText.T("Chưa có ảnh bìa tải lên.", "No uploaded cover image yet.")
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 border-top pt-3 mt-4">
                <a href="/admin/sach" class="btn btn-outline-secondary">
                    @ViewText.T("Hủy", "Cancel")
                </a>
                <button type="submit"
                        class="btn bs-btn-primary px-4"
                        disabled="@(!hasCategories ? "disabled" : null)">
                    @(isEdit
                        ? ViewText.T("Lưu thay đổi", "Save Changes")
                        : ViewText.T("Tạo đầu sách", "Create Book"))
                </button>
            </div>
        </form>
    </div>
</section>

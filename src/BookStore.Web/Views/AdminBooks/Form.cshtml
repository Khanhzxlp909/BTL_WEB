@model BookFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit
        ? ViewText.T($"Chỉnh sửa sách #{Model.Id!.Value}", $"Edit Book #{Model.Id!.Value}")
        : ViewText.T("Thêm sách mới", "Add New Book");
    var formAction = isEdit ? $"/admin/sach/{Model.Id!.Value}/sua" : "/admin/sach/them";
    var errorCode = ViewData["ErrorCode"] as string;
    var traceId = ViewData["TraceId"] as string;
}

<div class="row g-4">
    <aside class="col-12 col-lg-3">
        @await Html.PartialAsync("_AdminNav")
    </aside>

    <div class="col-12 col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h3 bs-serif-heading mb-1">@ViewData["Title"]</h1>
                <p class="text-secondary small mb-0">
                    @if (isEdit)
                    {
                        @ViewText.T(
                            "Cập nhật thông tin biên mục, giá bán và ảnh bìa. Số lượng tồn kho chỉ thay đổi qua phân hệ Kho và Đơn hàng.",
                            "Update bibliographic details, pricing, and cover image. Stock quantities change only via Inventory and Orders.")
                    }
                    else
                    {
                        @ViewText.T(
                            "Tạo đầu sách mới với tồn kho khởi tạo bằng 0. Sau khi lưu, bạn có thể nhập kho tại phân hệ Kho.",
                            "Create a new book with initial stock of 0. After saving, you can import stock in the Inventory module.")
                    }
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (isEdit)
                {
                    <a href="/admin/kho/@Model.Id!.Value/nhap" class="btn btn-sm btn-outline-secondary">
                        @ViewText.T("Nhập kho sách này", "Import Stock")
                    </a>
                    <a href="/admin/kho/@Model.Id!.Value/lich-su" class="btn btn-sm btn-outline-secondary">
                        @ViewText.T("Lịch sử kho", "Stock History")
                    </a>
                }
                <a href="/admin/sach" class="btn btn-sm btn-outline-secondary">
                    @ViewText.T("Quay về danh sách sách", "Back to Books")
                </a>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(errorCode))
        {
            <div class="alert alert-danger" role="alert">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                    <strong>@ViewText.T("Không thể lưu thông tin sách. Vui lòng kiểm tra các trường bên dưới:", "Unable to save book details. Please review the fields below:")</strong>
                    @if (!string.IsNullOrWhiteSpace(errorCode))
                    {
                        <code class="bs-error-code">@errorCode</code>
                    }
                </div>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="small mb-1"></div>
                }
                <div class="small fw-medium">
                    @ViewText.T(
                        "Lưu ý: Nếu bạn vừa chọn tệp ảnh bìa mới trước khi gặp lỗi, vui lòng chọn lại tệp ảnh trước khi gửi biểu mẫu.",
                        "Note: If you selected a new cover image file before this error, please re-select the image file before submitting again.")
                </div>
                @if (!string.IsNullOrWhiteSpace(traceId))
                {
                    <div class="small text-secondary mt-2">
                        @ViewText.T("Mã tra cứu (TraceId):", "Reference ID (TraceId):") <code>@traceId</code>
                    </div>
                }
            </div>
        }

        <section class="card bs-surface-card">
            <div class="card-body p-4">
                <form method="post"
                      action="@formAction"
                      enctype="multipart/form-data"
                      asp-antiforgery="true"
                      data-prevent-double-submit="true"
                      novalidate>
                    <div class="row g-3">
                        <div class="col-12 col-md-8">
                            <label asp-for="Title" class="form-label fw-semibold">
                                @ViewText.T("Tên sách", "Book Title") <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control" maxlength="255" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-4">
                            <label asp-for="SKU" class="form-label fw-semibold">
                                @ViewText.T("Mã SKU", "SKU Code") <span class="text-danger">*</span>
                            </label>
                            <input asp-for="SKU" class="form-control" maxlength="64" required />
                            <div class="form-text small">
                                @ViewText.T("Duy nhất trên toàn hệ thống (tự động chuẩn hóa in hoa).", "Unique system-wide (automatically normalized to uppercase).")
                            </div>
                            <span asp-validation-for="SKU" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Author" class="form-label fw-semibold">
                                @ViewText.T("Tác giả", "Author") <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Author" class="form-control" maxlength="150" required />
                            <span asp-validation-for="Author" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                @ViewText.T("Thể loại", "Category") <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CategoryId" class="form-select" required>
                                <option value="">@ViewText.T("-- Chọn thể loại đang hoạt động --", "-- Select an active category --")</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-5">
                            <label asp-for="Publisher" class="form-label fw-semibold">
                                @ViewText.T("Nhà xuất bản", "Publisher")
                            </label>
                            <input asp-for="Publisher" class="form-control" maxlength="150" />
                            <span asp-validation-for="Publisher" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6 col-md-4">
                            <label asp-for="ISBN" class="form-label fw-semibold">
                                @ViewText.T("Mã ISBN", "ISBN")
                            </label>
                            <input asp-for="ISBN" class="form-control" maxlength="30" />
                            <span asp-validation-for="ISBN" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6 col-md-3">
                            <label asp-for="PublishedYear" class="form-label fw-semibold">
                                @ViewText.T("Năm xuất bản", "Publication Year")
                            </label>
                            <input asp-for="PublishedYear"
                                   type="number"
                                   min="1"
                                   step="1"
                                   inputmode="numeric"
                                   class="form-control" />
                            <span asp-validation-for="PublishedYear" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="Price" class="form-label fw-semibold">
                                @ViewText.T("Giá gốc (VND nguyên)", "Regular Price (whole VND)") <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Price"
                                   type="number"
                                   min="1"
                                   step="1"
                                   inputmode="numeric"
                                   class="form-control"
                                   required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label asp-for="DiscountPrice" class="form-label fw-semibold">
                                @ViewText.T("Giá khuyến mãi (VND nguyên, tùy chọn)", "Discount Price (whole VND, optional)")
                            </label>
                            <input asp-for="DiscountPrice"
                                   type="number"
                                   min="1"
                                   step="1"
                                   inputmode="numeric"
                                   class="form-control" />
                            <div class="form-text small">
                                @ViewText.T("Để trống nếu không giảm giá; nếu nhập phải là số nguyên dương không vượt giá gốc.", "Leave blank if not discounted; must be a positive whole VND amount no greater than regular price.")
                            </div>
                            <span asp-validation-for="DiscountPrice" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold">
                                @ViewText.T("Mô tả nội dung", "Description")
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded-3 border bg-light">
                                <div class="row g-3 align-items-center">
                                    <div class="col-12 col-md-8">
                                        <label asp-for="CoverFile" class="form-label fw-semibold mb-1">
                                            @ViewText.T("Tệp ảnh bìa (tùy chọn)", "Cover Image File (optional)")
                                        </label>
                                        <input asp-for="CoverFile"
                                               type="file"
                                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                               class="form-control" />
                                        <div class="form-text small">
                                            @ViewText.T(
                                                "Chấp nhận tệp .jpg, .jpeg, .png hoặc .webp, dung lượng tối đa 5 MB. Hệ thống sẽ xác thực định dạng và chuẩn hóa sang WEBP an toàn.",
                                                "Accepts .jpg, .jpeg, .png, or .webp files up to 5 MB. The server validates and re-encodes the image to safe WEBP.")
                                        </div>
                                        <span asp-validation-for="CoverFile" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12 col-md-4 text-md-end">
                                        @if (!string.IsNullOrWhiteSpace(Model.ExistingCoverImage))
                                        {
                                            <div class="small text-secondary mb-1">
                                                @ViewText.T("Ảnh bìa hiện tại:", "Current cover image:")
                                            </div>
                                            <img src="@Model.ExistingCoverImage"
                                                 alt="@Model.Title"
                                                 class="bs-admin-cover-preview" />
                                        }
                                        else
                                        {
                                            <div class="small text-secondary">
                                                @ViewText.T("Chưa có ảnh bìa tải lên (sẽ dùng bìa chữ mặc định).", "No uploaded cover image yet (default typographic cover will be used).")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3 mt-4">
                        <div class="small text-secondary">
                            @ViewText.T(
                                "Tồn kho không chỉnh sửa trực tiếp tại biểu mẫu sách.",
                                "Inventory quantity is not edited directly in the book form.")
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="/admin/sach" class="btn btn-outline-secondary">
                                @ViewText.T("Hủy", "Cancel")
                            </a>
                            <button type="submit" class="btn bs-btn-primary px-4">
                                @(isEdit
                                    ? ViewText.T("Lưu thay đổi", "Save Changes")
                                    : ViewText.T("Tạo sách mới", "Create Book"))
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="/js/admin.js"></script>
}

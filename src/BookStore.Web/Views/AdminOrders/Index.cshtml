@model OrderListViewModel
@{
    ViewData["Title"] = ViewText.T("Quản trị đơn hàng", "Manage Orders");
}

<div class="row g-4">
    <aside class="col-12 col-lg-3">
        @await Html.PartialAsync("_AdminNav")
    </aside>

    <div class="col-12 col-lg-9">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h1 class="h3 bs-serif-heading mb-1">
                    @ViewText.T("Quản lý đơn hàng", "Order Management")
                </h1>
                <p class="text-secondary small mb-0">
                    @ViewText.T(
                        "Tra cứu theo mã đơn, khách hàng, trạng thái và khoảng ngày; xử lý giao hàng COD và đối soát tồn kho.",
                        "Search by order code, customer, status, and date range; manage COD workflow transitions and stock reservations.")
                </p>
            </div>
        </div>

        @await Html.PartialAsync("_OrderListContent", Model)
    </div>
</div>

@section Scripts {
    <script src="/js/admin.js"></script>
}

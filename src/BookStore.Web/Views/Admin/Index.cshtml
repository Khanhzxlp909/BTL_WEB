@model DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = ViewText.T("Bảng điều khiển", "Dashboard");
}

@section PageActions {
    <a href="/admin/sach/them" class="btn btn-sm bs-btn-primary">
        + @ViewText.T("Thêm sách mới", "Add Book")
    </a>
}

<section class="mb-4" aria-label="@ViewText.T("Chỉ số vận hành", "Operational Metrics")">
    <div class="bs-metric-grid">
        <div class="bs-metric-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Đơn đã giao", "Delivered Orders")
                    </div>
                    <div class="bs-metric-value">@Model.DeliveredOrders</div>
                </div>
                <span class="bs-metric-icon bs-metric-icon-success" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </span>
            </div>
            <a href="/admin/don-hang?Status=DELIVERED" class="small fw-semibold text-decoration-none">
                @ViewText.T("Xem đơn đã giao", "View delivered") &rarr;
            </a>
        </div>

        <div class="bs-metric-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Đơn chờ xác nhận", "Pending Orders")
                    </div>
                    <div class="bs-metric-value">@Model.PendingOrders</div>
                </div>
                <span class="bs-metric-icon bs-metric-icon-warning" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                </span>
            </div>
            <a href="/admin/don-hang?Status=PENDING" class="small fw-semibold text-decoration-none">
                @ViewText.T("Xử lý đơn chờ", "Process pending") &rarr;
            </a>
        </div>

        <div class="bs-metric-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Đơn đã hủy", "Cancelled Orders")
                    </div>
                    <div class="bs-metric-value">@Model.CancelledOrders</div>
                </div>
                <span class="bs-metric-icon bs-metric-icon-danger" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <path d="m15 9-6 6" />
                        <path d="m9 9 6 6" />
                    </svg>
                </span>
            </div>
            <a href="/admin/don-hang?Status=CANCELLED" class="small fw-semibold text-decoration-none">
                @ViewText.T("Xem đơn đã hủy", "View cancelled") &rarr;
            </a>
        </div>

        <div class="bs-metric-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Sách đang bán", "Active Books")
                    </div>
                    <div class="bs-metric-value">@Model.Books</div>
                </div>
                <span class="bs-metric-icon bs-metric-icon-brand" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
                    </svg>
                </span>
            </div>
            <a href="/admin/sach?Status=active" class="small fw-semibold text-decoration-none">
                @ViewText.T("Quản lý sách", "Manage books") &rarr;
            </a>
        </div>

        <div class="bs-metric-card">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <div class="small text-secondary fw-medium mb-1">
                        @ViewText.T("Khách hàng", "Customers")
                    </div>
                    <div class="bs-metric-value">@Model.Customers</div>
                </div>
                <span class="bs-metric-icon bs-metric-icon-info" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                </span>
            </div>
            <a href="/admin/khach-hang" class="small fw-semibold text-decoration-none">
                @ViewText.T("Xem khách hàng", "View customers") &rarr;
            </a>
        </div>
    </div>
</section>

<section class="card bs-surface-card" aria-labelledby="quick-actions-heading">
    <div class="card-body p-4">
        <h2 id="quick-actions-heading" class="h6 fw-bold mb-3">
            @ViewText.T("Thao tác thường dùng", "Quick Actions")
        </h2>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/admin/sach/them" class="card h-100 p-3 text-decoration-none text-dark border">
                    <div class="fw-semibold mb-1">+ @ViewText.T("Thêm đầu sách mới", "Add New Book")</div>
                    <div class="small text-secondary">@ViewText.T("Tạo hồ sơ sách, giá bán và tải ảnh bìa", "Create book record, pricing, and cover image")</div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/admin/kho?LowStockOnly=true" class="card h-100 p-3 text-decoration-none text-dark border">
                    <div class="fw-semibold mb-1">@ViewText.T("Kiểm tra & Nhập kho", "Check & Import Stock")</div>
                    <div class="small text-secondary">@ViewText.T("Xem các đầu sách sắp hết hàng để nhập thêm", "Review low-stock titles and record imports")</div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/admin/don-hang?Status=PENDING" class="card h-100 p-3 text-decoration-none text-dark border">
                    <div class="fw-semibold mb-1">@ViewText.T("Xử lý đơn hàng chờ", "Process Pending Orders")</div>
                    <div class="small text-secondary">@ViewText.T("Xác nhận và chuyển trạng thái giao hàng COD", "Confirm orders and advance COD shipping")</div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <a href="/admin/bao-cao" class="card h-100 p-3 text-decoration-none text-dark border">
                    <div class="fw-semibold mb-1">@ViewText.T("Báo cáo doanh thu", "Revenue Reports")</div>
                    <div class="small text-secondary">@ViewText.T("Biểu đồ doanh thu theo ngày và sách bán chạy", "Daily revenue chart and top 5 best-sellers")</div>
                </a>
            </div>
        </div>
    </div>
</section>

@model HomeViewModel
@{
    ViewData["Title"] = ViewText.T("Trang chủ", "Home");
}

<section class="bs-hero" aria-labelledby="home-hero-heading">
    <div class="row align-items-center g-4">
        <div class="col-12 col-lg-7">
            <h1 id="home-hero-heading" class="bs-hero-title">
                @ViewText.T(
                    "Nhà sách trực tuyến cho người yêu đọc sách",
                    "Thoughtfully Curated Books for Every Reader")
            </h1>
            <p class="bs-hero-desc">
                @ViewText.T(
                    "Tìm kiếm nhanh theo tên sách, tác giả, mã SKU hoặc ISBN. Đặt hàng trực tuyến, miễn phí giao hàng và thanh toán khi nhận hàng (COD).",
                    "Search by title, author, SKU, or ISBN. Order online with free shipping and Cash on Delivery (COD).")
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a href="/sach" class="btn bs-btn-primary px-4">
                    @ViewText.T("Xem tất cả sách", "Browse All Books")
                </a>
                <a href="/sach?InStock=true" class="btn btn-outline-secondary px-3">
                    @ViewText.T("Sách còn hàng", "In-Stock Books")
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-5 d-none d-md-block">
            <div class="bs-hero-art">
                <img src="/images/hero-bookshelf.svg"
                     alt="@ViewText.T("Minh họa kệ sách BookStore", "BookStore bookshelf illustration")" />
            </div>
        </div>
    </div>
</section>

@if (!Model.IsDatabaseConfigured)
{
    <section class="card bs-surface-card mb-4" aria-labelledby="db-config-heading">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <span class="badge bs-badge-lowstock">
                    @ViewText.T("Chưa cấu hình cơ sở dữ liệu", "Database Not Configured")
                </span>
                <code>ConnectionStrings__BookStore</code>
            </div>
            <h2 id="db-config-heading" class="h5 fw-bold mb-2">
                @ViewText.T(
                    "Hướng dẫn kết nối SQL Server cho BookStore",
                    "Configure SQL Server Connection for BookStore")
            </h2>
            <p class="small text-secondary mb-3">
                @ViewText.T(
                    "Hệ thống chưa có chuỗi kết nối cơ sở dữ liệu hợp lệ. Hãy cấu hình biến môi trường hoặc User Secrets rồi khởi động lại ứng dụng:",
                    "No valid database connection string is configured yet. Set the environment variable or User Secrets and restart the application:")
            </p>
            <div class="bg-light border rounded-2 p-3 mb-3">
                <pre class="mb-0 small"><code>export ConnectionStrings__BookStore="Server=localhost,1433;Database=BookStore;User Id=sa;Password=Your_Strong_Password;TrustServerCertificate=True;"</code></pre>
            </div>
            <a href="/" class="btn btn-sm bs-btn-primary">
                @ViewText.T("Tải lại trang", "Reload Page")
            </a>
        </div>
    </section>
}
else
{
    <section class="mb-4" aria-labelledby="home-categories-heading">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <h2 id="home-categories-heading" class="h6 fw-bold mb-0">
                @ViewText.T("Thể loại sách", "Categories")
            </h2>
            <a href="/sach" class="small text-decoration-none fw-medium">
                @ViewText.T("Tất cả", "View all") &rarr;
            </a>
        </div>

        @if (Model.Categories.Count == 0)
        {
            <p class="small text-secondary mb-0">
                @ViewText.T("Chưa có thể loại sách nào.", "No categories available yet.")
            </p>
        }
        else
        {
            <div class="bs-chip-row">
                <a href="/sach" class="bs-category-chip active">
                    @ViewText.T("Tất cả sách", "All Books")
                </a>
                @foreach (var category in Model.Categories)
                {
                    <a href="/sach?CategoryId=@category.Id" class="bs-category-chip">
                        @category.Name
                    </a>
                }
            </div>
        }
    </section>

    <section aria-labelledby="home-newbooks-heading">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <h2 id="home-newbooks-heading" class="h5 bs-serif-heading fw-bold mb-0">
                @ViewText.T("Sách mới cập nhật", "New Releases")
            </h2>
            <a href="/sach?Sort=newest" class="small text-decoration-none fw-medium">
                @ViewText.T("Xem toàn bộ danh mục", "Full catalog") &rarr;
            </a>
        </div>

        @if (Model.NewBooks.Count == 0)
        {
            <div class="bs-empty-state">
                <h3 class="h6 fw-bold mb-1">@ViewText.T("Chưa có sách trong danh mục", "No books in catalog yet")</h3>
                <p class="small text-secondary mb-0">
                    @ViewText.T("Danh sách sách mới sẽ hiển thị tại đây khi được cập nhật.", "New titles will appear here once added to the catalog.")
                </p>
            </div>
        }
        else
        {
            <div class="bs-book-grid bs-book-grid-home">
                @foreach (var book in Model.NewBooks)
                {
                    @await Html.PartialAsync("_BookCard", book)
                }
            </div>
        }
    </section>
}
